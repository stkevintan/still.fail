// ── Cloud workspace / invitation / loginSession / account operations (21) ──

fn ops_cloud_request(op : String, params : base_codec::Json) -> OpResult {
  if op == "workspace.create" {
    return make_cloud_op(params, "POST", "/v1/workspaces", Some(p_pick(params, ["name", "invite_code"])))
  }
  if op == "workspace.rename" {
    let ws = match p_at(params, "workspace") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    return make_cloud_op(params, "PATCH", "/v1/workspaces/" + ws, Some(p_pick(params, ["name", "emoji", "icon"])))
  }
  if op == "workspace.setRelays" {
    let ws = match p_at(params, "workspace") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    return make_cloud_op(params, "PUT", "/v1/workspaces/" + ws + "/relays", Some(p_pick(params, ["relays"])))
  }
  if op == "workspace.setWay" {
    let ws = match p_at(params, "workspace") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    return make_cloud_op(params, "PUT", "/v1/workspaces/" + ws + "/ways", Some(p_pick(params, ["way", "on"])))
  }
  if op == "workspace.delete" {
    let ws = match p_at(params, "workspace") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    return make_cloud_op(params, "DELETE", "/v1/workspaces/" + ws, None)
  }
  if op == "workspace.invite" {
    let ws = match p_at(params, "workspace") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    return make_cloud_op(params, "POST", "/v1/workspaces/" + ws + "/invitations", Some(p_pick(params, ["role", "email"])))
  }
  if op == "workspace.removeAdded" {
    let ws = match p_at(params, "workspace") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    let em = match p_at(params, "email") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    return make_cloud_op(params, "DELETE", "/v1/workspaces/" + ws + "/added/" + em, None)
  }
  if op == "workspace.revokeInvitation" {
    let ws = match p_at(params, "workspace") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    let inv = match p_at(params, "invitation") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    return make_cloud_op(params, "DELETE", "/v1/workspaces/" + ws + "/invitations/" + inv, None)
  }
  if op == "workspace.setRole" {
    let ws = match p_at(params, "workspace") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    let mem = match p_at(params, "member") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    return make_cloud_op(params, "PATCH", "/v1/workspaces/" + ws + "/members/" + mem, Some(p_pick(params, ["role"])))
  }
  if op == "workspace.removeMember" {
    let ws = match p_at(params, "workspace") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    let mem = match p_at(params, "member") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    return make_cloud_op(params, "DELETE", "/v1/workspaces/" + ws + "/members/" + mem, None)
  }
  if op == "workspace.enroll" {
    let ws = match p_at(params, "workspace") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    return make_cloud_op(params, "POST", "/v1/workspaces/" + ws + "/enrollments", Some(p_pick(params, ["name"])))
  }
  if op == "workspace.createProvisionKey" {
    let ws = match p_at(params, "workspace") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    return make_cloud_op(params, "POST", "/v1/workspaces/" + ws + "/provision-keys", Some(p_pick(params, ["name", "days"])))
  }
  if op == "workspace.renameStation" {
    let ws = match p_at(params, "workspace") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    let st = match p_at(params, "station") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    return make_cloud_op(params, "PATCH", "/v1/workspaces/" + ws + "/stations/" + st, Some(p_pick(params, ["name", "emoji", "icon"])))
  }
  if op == "workspace.removeStation" {
    let ws = match p_at(params, "workspace") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    let st = match p_at(params, "station") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    return make_cloud_op(params, "DELETE", "/v1/workspaces/" + ws + "/stations/" + st, None)
  }
  if op == "workspace.feedbackReply" {
    let ws = match p_at(params, "workspace") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    let fid = match p_at(params, "id") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    return make_cloud_op(params, "POST", "/v1/workspaces/" + ws + "/feedback/" + fid + "/reply", Some(p_pick(params, ["text"])))
  }
  if op == "invitation.preview" {
    return make_cloud_op(params, "POST", "/v1/invitations/preview", Some(p_pick(params, ["token"])))
  }
  if op == "invitation.accept" {
    if p_has(params, "id") {
      let iid = match p_at(params, "id") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
      return make_cloud_op(params, "POST", "/v1/invitations/" + iid + "/accept", None)
    }
    return make_cloud_op(params, "POST", "/v1/invitations/accept", Some(p_pick(params, ["token"])))
  }
  if op == "invitation.decline" {
    let iid = match p_at(params, "id") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    return make_cloud_op(params, "POST", "/v1/invitations/" + iid + "/decline", None)
  }
  if op == "loginSession.revoke" {
    let sid = match p_at(params, "id") { Ok(s) => s; Err(e) => return OpResult::Invalid(e) }
    return make_cloud_op(params, "DELETE", "/v1/auth/sessions/" + sid, None)
  }
  if op == "account.setPicture" {
    return make_cloud_op(params, "PUT", "/v1/me/picture", Some(p_pick(params, ["picture"])))
  }
  if op == "account.removePicture" {
    return make_cloud_op(params, "DELETE", "/v1/me/picture", None)
  }
  OpResult::Unknown
}

/// Build the exact station or cloud HTTP request for `op` and `params`, matching `client/core-ts/src/ops.ts` `request()`.
pub fn ops_request(op : String, params : base_codec::Json) -> OpResult {
  if !op.contains(".") {
    return OpResult::Unknown
  }
  if op.starts_with("session.") {
    return ops_session_request(op, params)
  }
  if op.starts_with("chat.") || op.starts_with("chats.") {
    return ops_chat_request(op, params)
  }
  if op.starts_with("workspace.") || op.starts_with("invitation.") || op.starts_with("loginSession.") || op.starts_with("account.") {
    return ops_cloud_request(op, params)
  }
  if op.starts_with("preset.") || op.starts_with("file.") || op.starts_with("link.") || op.starts_with("widget.") ||
  op.starts_with("machineSessions.") || op.starts_with("profile.") || op.starts_with("skill.") || op.starts_with("login.") {
    return ops_preset_profile_request(op, params)
  }
  if op.starts_with("connect.") || op.starts_with("feishu.") || op.starts_with("comma.") || op.starts_with("group.") || op.starts_with("slack.") {
    return ops_connect_request(op, params)
  }
  if op.starts_with("software.") || op.starts_with("drive.") || op.starts_with("machineLogin.") ||
  op.starts_with("screen.") || op.starts_with("terminal.") || op.starts_with("signin.") {
    return ops_screen_drive_software_request(op, params)
  }
  ops_station_admin_request(op, params)
}

/// Real station HTTP request for `chat.send` (`POST /threads/<thread>/messages`, `station/sync.ts` `post`).
pub fn chat_send_request(station : String, thread : Int, body : base_codec::Json) -> OpRequest {
  OpRequest::{
    target: OpTarget::Station(station),
    method: "POST",
    path: "/threads/" + thread.to_string() + "/messages",
    body: Some(body),
    fallback: None,
    effect: OpEffect::Thread(false),
  }
}

/// Real station HTTP request for `markRead` (`PUT /threads/<thread>/read`, `{ n }`, `station/sync.ts` `read`).
pub fn chat_read_request(station : String, thread : Int, n : Int) -> OpRequest {
  OpRequest::{
    target: OpTarget::Station(station),
    method: "PUT",
    path: "/threads/" + thread.to_string() + "/read",
    body: Some(base_codec::json_obj([("n", base_codec::json_int(n))])),
    fallback: None,
    effect: OpEffect::Thread(false),
  }
}
