// `conversation-backfill` builder delegating shared conversation grouping to `station_conv`
// (zero duplicate implementation).

import "base_codec"
import "builders_core"
import "sql_db"
import "station_conv"

pub fn is_owned_ws(ws : base_codec::Json) -> Bool {
  station_conv::is_owned_ws(ws)
}

pub fn conv_cmp_earliest(a_at : Double, a_key : String, b_at : Double, b_key : String) -> Int {
  station_conv::conv_cmp_earliest(a_at, a_key, b_at, b_key)
}

pub fn split_session_thread(key : String) -> Option[(String, String)] {
  station_conv::split_session_thread(key)
}

pub fn birth_threads_of(
  db : sql_db::Db,
  key : String,
) -> Result[Array[base_codec::Json], builders_core::StepError] {
  match station_conv::birth_threads_of(db, key) {
    Ok(v) => Ok(v)
    Err(e) => Err(builders_core::StepError::Sql(e))
  }
}

pub fn settle_conversation_in_tx(
  db : sql_db::Db,
  thread_id : base_codec::Json,
  now : base_codec::Json,
  born : Option[String] = None,
) -> Result[(Array[String], Array[base_codec::Json]), builders_core::StepError] {
  match station_conv::settle_conversation_in_tx(db, thread_id, now, born=born) {
    Ok(v) => Ok(v)
    Err(e) => Err(builders_core::StepError::Sql(e))
  }
}

fn conv_contains_json(arr : Array[base_codec::Json], v : base_codec::Json) -> Bool {
  for i in 0..<arr.length() {
    if base_codec::json_eq(arr[i], v) {
      return true
    }
  }
  false
}

fn conv_str(v : base_codec::Json) -> Option[String] {
  match v {
    base_codec::Json::Str(s) => Some(s)
    _ => None
  }
}

/// One bounded batch of background conversation backfill (`conversation-backfill`).
/// Uses `sessions_conv_todo` partial index and converges by writing `conv = key` on lone/orphaned rows.
pub fn backfill_conversations_step(
  db : sql_db::Db,
  now : base_codec::Json,
  limit : Int = 32,
) -> Result[Bool, builders_core::StepError] {
  let rows = match db.all(
    "SELECT key FROM sessions INDEXED BY sessions_conv_todo WHERE scope = 'thread' AND conv IS NULL AND " +
    station_conv::owned_ws_sql +
    " ORDER BY key LIMIT ?",
    [base_codec::json_num(limit.to_double())],
  ) {
    Ok(r) => r
    Err(e) => return Err(builders_core::StepError::Sql(e))
  }
  if rows.length() == 0 {
    return Ok(true)
  }
  let settled : Array[base_codec::Json] = []
  match db.tx_err(
    fn(tx_db : sql_db::Db) -> Result[Unit, builders_core::StepError] {
      for i in 0..<rows.length() {
        let key = match conv_str(sql_db::row_val(rows[i], "key")) {
          Some(k) => k
          None => continue
        }
        let tids = match birth_threads_of(tx_db, key) {
          Ok(ts) => ts
          Err(e) => return Err(e)
        }
        for j in 0..<tids.length() {
          let tid = tids[j]
          if !conv_contains_json(settled, tid) {
            settled.push(tid)
            match settle_conversation_in_tx(tx_db, tid, now) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
          }
        }
        match tx_db.run("UPDATE sessions SET conv = key WHERE key = ? AND conv IS NULL", [base_codec::json_str(key)]) {
          Ok(_) => ()
          Err(e) => return Err(builders_core::StepError::Sql(e))
        }
      }
      Ok(())
    },
    map_sql,
  ) {
    Ok(_) => Ok(rows.length() < limit)
    Err(e) => Err(e)
  }
}
