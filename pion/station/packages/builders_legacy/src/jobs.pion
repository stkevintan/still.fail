// 1:1 port of `station/mb/src/jobs/{active.mbt, jobs.mbt}`:
// - `active_step` (`active-jobs`)
// - `process_jobs_install`, `process_jobs_step` (`process-jobs`)
//
// Invariants:
// - All write transactions go exclusively through `db.tx_err(...)` (zero raw tx SQL).
// - All `CREATE TRIGGER ... BEGIN ... END;` literals are self-contained.

import "base_codec"
import "builders_core"
import "sql_db"

let JOBS_VERSION : Int = 1

let LAST_RUNNING_SQL : String = "SELECT CAST(rowid AS TEXT) AS position FROM jobs INDEXED BY jobs_state WHERE state = 'running' ORDER BY rowid DESC LIMIT 1"

// ── Active Jobs Upgrade (`active.mbt`) ──

fn schema_exists(db : sql_db::Db, kind : String, name : String) -> Result[Bool, builders_core::StepError] {
  match db.first("SELECT 1 FROM sqlite_master WHERE type = ? AND name = ?", [base_codec::json_str(kind), base_codec::json_str(name)]) {
    Ok(Some(_)) => Ok(true)
    Ok(None) => Ok(false)
    Err(e) => Err(builders_core::StepError::Sql(e))
  }
}

fn active_conflict(other : Bool) -> String {
  let not_old = if other { "AND j.rowid IS NOT OLD.rowid" } else { "" }
  "SELECT j.session_key AS session, j.id AS job FROM ( SELECT rowid AS position FROM jobs WHERE id = NEW.id UNION SELECT rowid FROM jobs WHERE token = NEW.token UNION SELECT rowid FROM jobs WHERE rowid = NEW.rowid ) p CROSS JOIN jobs j ON j.rowid = p.position WHERE j.state = 'running' AND j.id IS NOT NULL " +
  not_old
}

let ACTIVE_CHANGED_SQL : String = "OLD.rowid IS NOT NEW.rowid OR OLD.id IS NOT NEW.id OR OLD.token IS NOT NEW.token OR OLD.session_key IS NOT NEW.session_key OR OLD.state IS NOT NEW.state OR OLD.watch IS NOT NEW.watch OR EXISTS (SELECT 1 FROM active_job_upgrade_replaced)"

fn active_stage(other : Bool) -> String {
  "DELETE FROM active_job_upgrade_replaced WHERE session IS NOT NULL; INSERT INTO active_job_upgrade_replaced (session, job) " +
  active_conflict(other) +
  ";"
}

fn active_see(watches : Bool, others : Bool, rowid : String) -> Array[String] {
  let out : Array[String] = []
  if watches {
    out.push(
      "INSERT INTO active_job_watch_build (job, session, token) SELECT j.id, j.session_key, j.token FROM jobs j WHERE j.rowid = " +
      rowid +
      " AND j.state = 'running' AND j.watch <> 0 AND (j.id IS NOT NULL OR (SELECT complete FROM active_job_upgrade WHERE id = 1) = 1) AND NOT EXISTS (SELECT 1 FROM active_job_watch_build w WHERE w.job = j.id)",
    )
  }
  if others {
    out.push(
      "INSERT INTO active_job_other_build (session, job) SELECT j.session_key, j.id FROM jobs j WHERE j.rowid = " +
      rowid +
      " AND j.state = 'running' AND j.watch = 0 AND (j.id IS NOT NULL OR (SELECT complete FROM active_job_upgrade WHERE id = 1) = 1) AND NOT EXISTS (SELECT 1 FROM active_job_other_build a WHERE a.session = j.session_key AND a.job = j.id)",
    )
  }
  out
}

fn active_see_joined(watches : Bool, others : Bool, rowid : String) -> String {
  let stmts = active_see(watches, others, rowid)
  let with_semi : Array[String] = []
  for i in 0..<stmts.length() {
    with_semi.push(stmts[i] + ";")
  }
  join_strings(with_semi, " ")
}

fn active_reconcile(watches : Bool, others : Bool) -> String {
  let w = if watches {
    "DELETE FROM active_job_watch_build WHERE job IN (SELECT job FROM active_job_upgrade_replaced) AND NOT EXISTS (SELECT 1 FROM jobs j WHERE j.id = active_job_watch_build.job AND j.state = 'running' AND j.watch <> 0 AND j.session_key = active_job_watch_build.session AND j.token = active_job_watch_build.token); INSERT INTO active_job_watch_build (job, session, token) SELECT j.id, j.session_key, j.token FROM active_job_upgrade_replaced r CROSS JOIN jobs j ON j.id = r.job WHERE j.state = 'running' AND j.watch <> 0 AND NOT EXISTS (SELECT 1 FROM active_job_watch_build w WHERE w.job = j.id);"
  } else {
    ""
  }
  let o = if others {
    "DELETE FROM active_job_other_build WHERE (session, job) IN (SELECT session, job FROM active_job_upgrade_replaced) AND NOT EXISTS (SELECT 1 FROM jobs j WHERE j.id = active_job_other_build.job AND j.state = 'running' AND j.watch = 0 AND j.session_key = active_job_other_build.session); INSERT INTO active_job_other_build (session, job) SELECT j.session_key, j.id FROM active_job_upgrade_replaced r CROSS JOIN jobs j ON j.id = r.job WHERE j.state = 'running' AND j.watch = 0 AND NOT EXISTS (SELECT 1 FROM active_job_other_build a WHERE a.session = j.session_key AND a.job = j.id);"
  } else {
    ""
  }
  w + " " + o + " DELETE FROM active_job_upgrade_replaced WHERE session IS NOT NULL;"
}

fn active_drop(watches : Bool, others : Bool) -> String {
  let w = if watches { "DELETE FROM active_job_watch_build WHERE job = OLD.id;" } else { "" }
  let o = if others { "DELETE FROM active_job_other_build WHERE session = OLD.session_key AND job = OLD.id;" } else { "" }
  w + " " + o
}

fn active_schema_stmts(watches : Bool, others : Bool) -> Array[String] {
  let wf = if watches { "1" } else { "0" }
  let of = if others { "1" } else { "0" }
  let out : Array[String] = [
    "CREATE TABLE active_job_upgrade (id INTEGER PRIMARY KEY CHECK (id = 1), version INTEGER NOT NULL, complete INTEGER NOT NULL, watches INTEGER NOT NULL, others INTEGER NOT NULL, cursor INTEGER, end_rowid INTEGER, schema_version INTEGER) WITHOUT ROWID;",
    "INSERT INTO active_job_upgrade VALUES (1, 1, 0, " +
    wf +
    ", " +
    of +
    ", NULL, CAST((" +
    LAST_RUNNING_SQL +
    ") AS INTEGER), NULL);",
    "CREATE TABLE active_job_upgrade_replaced (session TEXT NOT NULL, job TEXT NOT NULL, PRIMARY KEY (session, job)) WITHOUT ROWID;",
  ]
  if watches {
    out.push(
      "CREATE TABLE active_job_watch_build (job TEXT PRIMARY KEY, session TEXT NOT NULL, token TEXT NOT NULL UNIQUE) WITHOUT ROWID; CREATE INDEX active_watch_jobs_session ON active_job_watch_build (session);",
    )
  }
  if others {
    out.push(
      "CREATE TABLE active_job_other_build (session TEXT NOT NULL, job TEXT NOT NULL, PRIMARY KEY (session, job)) WITHOUT ROWID; CREATE INDEX active_other_remote_jobs ON active_job_other_build (job) WHERE job >= 'remote_' AND job < 'remote`';",
    )
  }
  out.push(
    "CREATE TRIGGER active_job_upgrade_before_add BEFORE INSERT ON jobs WHEN EXISTS (SELECT 1 FROM active_job_upgrade_replaced) OR EXISTS (" +
    active_conflict(false) +
    ") BEGIN " +
    active_stage(false) +
    " END;",
  )
  out.push(
    "CREATE TRIGGER active_job_upgrade_add AFTER INSERT ON jobs WHEN NEW.state = 'running' OR EXISTS (SELECT 1 FROM active_job_upgrade_replaced) BEGIN " +
    active_reconcile(watches, others) +
    " " +
    active_see_joined(watches, others, "NEW.rowid") +
    " END;",
  )
  out.push(
    "CREATE TRIGGER active_job_upgrade_before_change BEFORE UPDATE ON jobs WHEN EXISTS (SELECT 1 FROM active_job_upgrade_replaced) OR ((OLD.rowid IS NOT NEW.rowid OR OLD.id IS NOT NEW.id OR OLD.token IS NOT NEW.token) AND EXISTS (" +
    active_conflict(true) +
    ")) BEGIN " +
    active_stage(true) +
    " END;",
  )
  out.push(
    "CREATE TRIGGER active_job_upgrade_change AFTER UPDATE ON jobs WHEN " +
    ACTIVE_CHANGED_SQL +
    " BEGIN " +
    active_drop(watches, others) +
    " " +
    active_reconcile(watches, others) +
    " " +
    active_see_joined(watches, others, "NEW.rowid") +
    " END;",
  )
  out.push(
    "CREATE TRIGGER active_job_upgrade_drop AFTER DELETE ON jobs WHEN OLD.state = 'running' BEGIN " +
    active_drop(watches, others) +
    " END;",
  )
  out
}

fn upgrade_meta(db : sql_db::Db) -> Result[Option[Map[String, base_codec::Json]], builders_core::StepError] {
  match schema_exists(db, "table", "active_job_upgrade") {
    Ok(false) => return Ok(None)
    Ok(true) => ()
    Err(e) => return Err(e)
  }
  let row = match db.first(
    "SELECT version, complete, watches, others, CAST(cursor AS TEXT) AS cursor, CAST(end_rowid AS TEXT) AS end_rowid, schema_version FROM active_job_upgrade WHERE id = 1",
    [],
  ) {
    Ok(r) => r
    Err(e) => return Err(builders_core::StepError::Sql(e))
  }
  let v = match row {
    Some(r) => sql_db::row_val(r, "version")
    None => base_codec::json_null()
  }
  let ok_ver = match v {
    base_codec::Json::Num(n, _) => n.to_int() == JOBS_VERSION
    _ => false
  }
  match row {
    Some(r) => {
      if !ok_ver {
        let said = if is_json_null(v) { "missing" } else { sql_db::stringify_json(v) }
        return Err(
          builders_core::StepError::App(
            "active job upgrade version " + said + " is incompatible with " + JOBS_VERSION.to_string(),
          ),
        )
      }
      Ok(Some(r))
    }
    None => {
      Err(
        builders_core::StepError::App(
          "active job upgrade version missing is incompatible with " + JOBS_VERSION.to_string(),
        ),
      )
    }
  }
}

fn remote_ready(db : sql_db::Db) -> Result[Bool, builders_core::StepError] {
  match schema_exists(db, "table", "active_remote_job_meta") {
    Ok(false) => return Ok(false)
    Ok(true) => ()
    Err(e) => return Err(e)
  }
  match db.first("SELECT version, complete FROM active_remote_job_meta WHERE id = 1", []) {
    Ok(Some(r)) => Ok(json_is_one(sql_db::row_val(r, "version")) && json_is_one(sql_db::row_val(r, "complete")))
    Ok(None) => Ok(false)
    Err(e) => Err(builders_core::StepError::Sql(e))
  }
}

fn upgrade_ready(db : sql_db::Db) -> Result[Bool, builders_core::StepError] {
  match schema_exists(db, "table", "active_watch_jobs") {
    Ok(false) => return Ok(false)
    Ok(true) => ()
    Err(e) => return Err(e)
  }
  match schema_exists(db, "table", "active_other_jobs") {
    Ok(false) => return Ok(false)
    Ok(true) => ()
    Err(e) => return Err(e)
  }
  match schema_exists(db, "index", "active_other_remote_jobs") {
    Ok(true) => return Ok(true)
    Ok(false) => ()
    Err(e) => return Err(e)
  }
  remote_ready(db)
}

fn install_upgrade(db : sql_db::Db) -> Result[Unit, builders_core::StepError] {
  match upgrade_meta(db) {
    Ok(Some(_)) => return Ok(())
    Ok(None) => ()
    Err(e) => return Err(e)
  }
  let has_w = match schema_exists(db, "table", "active_watch_jobs") {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let has_o = match schema_exists(db, "table", "active_other_jobs") {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  if has_w && has_o {
    return Ok(())
  }
  db.tx_err(
    fn(tx_db : sql_db::Db) -> Result[Unit, builders_core::StepError] {
      match upgrade_meta(tx_db) {
        Ok(Some(_)) => return Ok(())
        Ok(None) => ()
        Err(e) => return Err(e)
      }
      let watches = match schema_exists(tx_db, "table", "active_watch_jobs") {
        Ok(b) => !b
        Err(e) => return Err(e)
      }
      let others = match schema_exists(tx_db, "table", "active_other_jobs") {
        Ok(b) => !b
        Err(e) => return Err(e)
      }
      if watches || others {
        let stmts = active_schema_stmts(watches, others)
        for i in 0..<stmts.length() {
          match tx_db.exec(stmts[i]) {
            Ok(_) => ()
            Err(e) => return Err(builders_core::StepError::Sql(e))
          }
        }
        let sv = match tx_db.schema_version() {
          Ok(v) => v
          Err(e) => return Err(builders_core::StepError::Sql(e))
        }
        match tx_db.run("UPDATE active_job_upgrade SET schema_version = ? WHERE id = 1", [sv]) {
          Ok(_) => ()
          Err(e) => return Err(builders_core::StepError::Sql(e))
        }
      }
      Ok(())
    },
    map_sql,
  )
}

fn remote_schema_stmts() -> Array[String] {
  [
    "CREATE TABLE active_remote_job_meta (id INTEGER PRIMARY KEY CHECK (id = 1), version INTEGER NOT NULL, complete INTEGER NOT NULL, cursor_session TEXT, cursor_job TEXT, end_session TEXT, end_job TEXT) WITHOUT ROWID;",
    "INSERT INTO active_remote_job_meta SELECT 1, 1, 0, NULL, NULL, (SELECT session FROM active_other_jobs ORDER BY session DESC, job DESC LIMIT 1), (SELECT job FROM active_other_jobs ORDER BY session DESC, job DESC LIMIT 1);",
    "CREATE TABLE active_remote_job_rows (job TEXT NOT NULL, session TEXT NOT NULL, PRIMARY KEY (job, session)) WITHOUT ROWID;",
    "CREATE TRIGGER active_remote_job_add AFTER INSERT ON active_other_jobs WHEN NEW.job >= 'remote_' AND NEW.job < 'remote`' BEGIN INSERT OR IGNORE INTO active_remote_job_rows VALUES (NEW.job, NEW.session); END;",
    "CREATE TRIGGER active_remote_job_drop AFTER DELETE ON active_other_jobs WHEN OLD.job >= 'remote_' AND OLD.job < 'remote`' BEGIN DELETE FROM active_remote_job_rows WHERE job = OLD.job AND session = OLD.session; END;",
    "CREATE TRIGGER active_remote_job_change AFTER UPDATE ON active_other_jobs BEGIN DELETE FROM active_remote_job_rows WHERE job = OLD.job AND session = OLD.session; INSERT OR IGNORE INTO active_remote_job_rows SELECT NEW.job, NEW.session WHERE NEW.job >= 'remote_' AND NEW.job < 'remote`'; END;",
  ]
}

fn install_remote(db : sql_db::Db) -> Result[Unit, builders_core::StepError] {
  let has_idx = match schema_exists(db, "index", "active_other_remote_jobs") {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let has_meta = match schema_exists(db, "table", "active_remote_job_meta") {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let has_other = match schema_exists(db, "table", "active_other_jobs") {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  if has_idx || has_meta || !has_other {
    return Ok(())
  }
  db.tx_err(
    fn(tx_db : sql_db::Db) -> Result[Unit, builders_core::StepError] {
      let idx2 = match schema_exists(tx_db, "index", "active_other_remote_jobs") {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      let meta2 = match schema_exists(tx_db, "table", "active_remote_job_meta") {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      if !idx2 && !meta2 {
        let stmts = remote_schema_stmts()
        for i in 0..<stmts.length() {
          match tx_db.exec(stmts[i]) {
            Ok(_) => ()
            Err(e) => return Err(builders_core::StepError::Sql(e))
          }
        }
      }
      Ok(())
    },
    map_sql,
  )
}

fn remote_step(db : sql_db::Db, limit : Int) -> Result[Bool, builders_core::StepError] {
  match schema_exists(db, "index", "active_other_remote_jobs") {
    Ok(true) => return upgrade_ready(db)
    Ok(false) => ()
    Err(e) => return Err(e)
  }
  match install_remote(db) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match schema_exists(db, "table", "active_remote_job_meta") {
    Ok(false) => return Ok(false)
    Ok(true) => ()
    Err(e) => return Err(e)
  }
  let done = match db.tx_err(
    fn(tx_db : sql_db::Db) -> Result[Bool, builders_core::StepError] {
      let row = match tx_db.first("SELECT * FROM active_remote_job_meta WHERE id = 1", []) {
        Ok(Some(r)) => r
        Ok(None) => return Err(builders_core::StepError::App("active remote job metadata is missing"))
        Err(e) => return Err(builders_core::StepError::Sql(e))
      }
      let ver = sql_db::row_val(row, "version")
      if !json_is_one(ver) {
        return Err(
          builders_core::StepError::App(
            "active remote job version " + sql_db::stringify_json(ver) + " is incompatible with " + JOBS_VERSION.to_string(),
          ),
        )
      }
      if json_is_one(sql_db::row_val(row, "complete")) {
        return Ok(true)
      }
      let lim = base_codec::json_num(limit.to_double())
      let end_session = sql_db::row_val(row, "end_session")
      let end_job = sql_db::row_val(row, "end_job")
      let cursor_session = sql_db::row_val(row, "cursor_session")
      let cursor_job = sql_db::row_val(row, "cursor_job")
      let rows = if is_json_null(end_session) {
        []
      } else if is_json_null(cursor_session) {
        match tx_db.all(
          "SELECT session, job FROM active_other_jobs WHERE (session, job) <= (?, ?) ORDER BY session, job LIMIT ?",
          [end_session, end_job, lim],
        ) {
          Ok(r) => r
          Err(e) => return Err(builders_core::StepError::Sql(e))
        }
      } else {
        match tx_db.all(
          "SELECT session, job FROM active_other_jobs WHERE (session, job) > (?, ?) AND (session, job) <= (?, ?) ORDER BY session, job LIMIT ?",
          [cursor_session, cursor_job, end_session, end_job, lim],
        ) {
          Ok(r) => r
          Err(e) => return Err(builders_core::StepError::Sql(e))
        }
      }
      for i in 0..<rows.length() {
        let r = rows[i]
        match tx_db.run(
          "INSERT OR IGNORE INTO active_remote_job_rows SELECT job, session FROM active_other_jobs WHERE session = ? AND job = ? AND job >= 'remote_' AND job < 'remote`'",
          [sql_db::row_val(r, "session"), sql_db::row_val(r, "job")],
        ) {
          Ok(_) => ()
          Err(e) => return Err(builders_core::StepError::Sql(e))
        }
      }
      let finished = rows.length() < limit
      let (next_ses, next_job) = if rows.length() > 0 {
        let last = rows[rows.length() - 1]
        (sql_db::row_val(last, "session"), sql_db::row_val(last, "job"))
      } else {
        (cursor_session, cursor_job)
      }
      match tx_db.run(
        "UPDATE active_remote_job_meta SET cursor_session = ?, cursor_job = ?, complete = ? WHERE id = 1",
        [next_ses, next_job, json_flag(finished)],
      ) {
        Ok(_) => ()
        Err(e) => return Err(builders_core::StepError::Sql(e))
      }
      Ok(finished)
    },
    map_sql,
  ) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  if !done {
    return Ok(false)
  }
  upgrade_ready(db)
}

pub fn active_step(db : sql_db::Db, limit : Int = 64) -> Result[Bool, builders_core::StepError] {
  if limit < 1 {
    return Err(builders_core::StepError::App("active job batch must be positive"))
  }
  match install_upgrade(db) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match upgrade_meta(db) {
    Ok(None) => return remote_step(db, limit)
    Ok(Some(m)) => {
      if json_is_one(sql_db::row_val(m, "complete")) {
        return remote_step(db, limit)
      }
    }
    Err(e) => return Err(e)
  }
  let finished = match db.tx_err(
    fn(tx_db : sql_db::Db) -> Result[Bool, builders_core::StepError] {
      let current = match upgrade_meta(tx_db) {
        Ok(Some(r)) => r
        Ok(None) => return Err(builders_core::StepError::App("active job upgrade is missing"))
        Err(e) => return Err(e)
      }
      if json_is_one(sql_db::row_val(current, "complete")) {
        return Ok(true)
      }
      let schema = match tx_db.schema_version() {
        Ok(v) => v
        Err(e) => return Err(builders_core::StepError::Sql(e))
      }
      let (cursor, end) = if !base_codec::json_eq(schema, sql_db::row_val(current, "schema_version")) {
        let last_pos = match tx_db.first(LAST_RUNNING_SQL, []) {
          Ok(Some(r)) => sql_db::row_val(r, "position")
          Ok(None) => base_codec::json_null()
          Err(e) => return Err(builders_core::StepError::Sql(e))
        }
        (base_codec::json_null(), last_pos)
      } else {
        (sql_db::row_val(current, "cursor"), sql_db::row_val(current, "end_rowid"))
      }
      let lim = base_codec::json_num(limit.to_double())
      let rows = if is_json_null(end) {
        []
      } else if is_json_null(cursor) {
        match tx_db.all(
          "SELECT CAST(rowid AS TEXT) AS position FROM jobs INDEXED BY jobs_state WHERE state = 'running' AND rowid <= CAST(? AS INTEGER) ORDER BY rowid LIMIT ?",
          [end, lim],
        ) {
          Ok(r) => r
          Err(e) => return Err(builders_core::StepError::Sql(e))
        }
      } else {
        match tx_db.all(
          "SELECT CAST(rowid AS TEXT) AS position FROM jobs INDEXED BY jobs_state WHERE state = 'running' AND rowid > CAST(? AS INTEGER) AND rowid <= CAST(? AS INTEGER) ORDER BY rowid LIMIT ?",
          [cursor, end, lim],
        ) {
          Ok(r) => r
          Err(e) => return Err(builders_core::StepError::Sql(e))
        }
      }
      let watches = json_is_one(sql_db::row_val(current, "watches"))
      let others = json_is_one(sql_db::row_val(current, "others"))
      let puts = active_see(watches, others, "CAST(? AS INTEGER)")
      for i in 0..<rows.length() {
        let pos = sql_db::row_val(rows[i], "position")
        for j in 0..<puts.length() {
          match tx_db.run(puts[j], [pos]) {
            Ok(_) => ()
            Err(e) => return Err(builders_core::StepError::Sql(e))
          }
        }
      }
      let fin = rows.length() < limit
      if fin {
        match tx_db.first(
          "SELECT 1 FROM jobs INDEXED BY sqlite_autoindex_jobs_1 WHERE id IS NULL AND state = 'running' LIMIT 1",
          [],
        ) {
          Ok(Some(_)) => return Err(builders_core::StepError::App("a running job without an id cannot yet be indexed"))
          Ok(None) => ()
          Err(e) => return Err(builders_core::StepError::Sql(e))
        }
        if watches {
          match tx_db.exec("ALTER TABLE active_job_watch_build RENAME TO active_watch_jobs") {
            Ok(_) => ()
            Err(e) => return Err(builders_core::StepError::Sql(e))
          }
        }
        if others {
          match tx_db.exec("ALTER TABLE active_job_other_build RENAME TO active_other_jobs") {
            Ok(_) => ()
            Err(e) => return Err(builders_core::StepError::Sql(e))
          }
        }
      }
      let reached = if rows.length() > 0 {
        sql_db::row_val(rows[rows.length() - 1], "position")
      } else {
        cursor
      }
      match tx_db.run(
        "UPDATE active_job_upgrade SET cursor = CAST(? AS INTEGER), end_rowid = CAST(? AS INTEGER), complete = ?, schema_version = ? WHERE id = 1",
        [reached, end, json_flag(fin), schema],
      ) {
        Ok(_) => ()
        Err(e) => return Err(builders_core::StepError::Sql(e))
      }
      Ok(fin)
    },
    map_sql,
  ) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  if !finished {
    return Ok(false)
  }
  upgrade_ready(db)
}

// ── Process Jobs Lookup (`jobs.mbt`) ──

fn process_jobs_schema_stmts() -> Array[String] {
  [
    "CREATE TABLE process_job_meta (id INTEGER PRIMARY KEY CHECK (id = 1), version INTEGER NOT NULL, complete INTEGER NOT NULL, cursor INTEGER, end_rowid INTEGER, schema_version INTEGER) WITHOUT ROWID;",
    "INSERT INTO process_job_meta (id, version, complete, cursor, end_rowid) VALUES (1, 1, 0, NULL, CAST((SELECT CAST(rowid AS TEXT) AS position FROM jobs INDEXED BY jobs_state WHERE state = 'running' ORDER BY rowid DESC LIMIT 1) AS INTEGER));",
    "CREATE TABLE process_job_rows (job TEXT PRIMARY KEY) WITHOUT ROWID;",
    "CREATE TABLE process_job_replaced (job TEXT PRIMARY KEY) WITHOUT ROWID;",
    "CREATE TRIGGER process_job_before_add BEFORE INSERT ON jobs WHEN EXISTS (SELECT 1 FROM process_job_replaced) OR EXISTS (SELECT j.id FROM ( SELECT rowid AS position FROM jobs WHERE id = NEW.id UNION SELECT rowid FROM jobs WHERE token = NEW.token UNION SELECT rowid FROM jobs WHERE rowid = NEW.rowid ) p CROSS JOIN jobs j ON j.rowid = p.position WHERE (j.state = 'running' AND j.pgid IS NOT NULL) AND j.id IS NOT NULL) BEGIN DELETE FROM process_job_replaced WHERE job IS NOT NULL; INSERT INTO process_job_replaced (job) SELECT j.id FROM ( SELECT rowid AS position FROM jobs WHERE id = NEW.id UNION SELECT rowid FROM jobs WHERE token = NEW.token UNION SELECT rowid FROM jobs WHERE rowid = NEW.rowid ) p CROSS JOIN jobs j ON j.rowid = p.position WHERE (j.state = 'running' AND j.pgid IS NOT NULL) AND j.id IS NOT NULL ; END;",
    "CREATE TRIGGER process_job_add AFTER INSERT ON jobs WHEN (NEW.state = 'running' AND NEW.pgid IS NOT NULL) OR EXISTS (SELECT 1 FROM process_job_replaced) BEGIN DELETE FROM process_job_rows WHERE job IN (SELECT job FROM process_job_replaced) AND NOT EXISTS (SELECT 1 FROM jobs j WHERE j.id = process_job_rows.job AND (j.state = 'running' AND j.pgid IS NOT NULL)); INSERT INTO process_job_rows (job) SELECT j.id FROM process_job_replaced p CROSS JOIN jobs j ON j.id = p.job WHERE (j.state = 'running' AND j.pgid IS NOT NULL) AND NOT EXISTS (SELECT 1 FROM process_job_rows r WHERE r.job = j.id); DELETE FROM process_job_replaced WHERE job IS NOT NULL; INSERT INTO process_job_rows (job) SELECT j.id FROM jobs j WHERE j.rowid = NEW.rowid AND j.id IS NOT NULL AND (j.state = 'running' AND j.pgid IS NOT NULL) AND NOT EXISTS (SELECT 1 FROM process_job_rows p WHERE p.job = j.id); END;",
    "CREATE TRIGGER process_job_before_change BEFORE UPDATE ON jobs WHEN OLD.rowid IS NOT NEW.rowid OR OLD.id IS NOT NEW.id OR OLD.token IS NOT NEW.token OR (OLD.state = 'running' AND OLD.pgid IS NOT NULL) IS NOT (NEW.state = 'running' AND NEW.pgid IS NOT NULL) OR EXISTS (SELECT 1 FROM process_job_replaced) BEGIN DELETE FROM process_job_replaced WHERE job IS NOT NULL; INSERT INTO process_job_replaced (job) SELECT j.id FROM ( SELECT rowid AS position FROM jobs WHERE id = NEW.id UNION SELECT rowid FROM jobs WHERE token = NEW.token UNION SELECT rowid FROM jobs WHERE rowid = NEW.rowid ) p CROSS JOIN jobs j ON j.rowid = p.position WHERE (j.state = 'running' AND j.pgid IS NOT NULL) AND j.id IS NOT NULL UNION SELECT OLD.id WHERE OLD.id IS NOT NULL AND (OLD.state = 'running' AND OLD.pgid IS NOT NULL); END;",
    "CREATE TRIGGER process_job_change AFTER UPDATE ON jobs WHEN OLD.rowid IS NOT NEW.rowid OR OLD.id IS NOT NEW.id OR OLD.token IS NOT NEW.token OR (OLD.state = 'running' AND OLD.pgid IS NOT NULL) IS NOT (NEW.state = 'running' AND NEW.pgid IS NOT NULL) OR EXISTS (SELECT 1 FROM process_job_replaced) BEGIN DELETE FROM process_job_rows WHERE job IN (SELECT job FROM process_job_replaced) AND NOT EXISTS (SELECT 1 FROM jobs j WHERE j.id = process_job_rows.job AND (j.state = 'running' AND j.pgid IS NOT NULL)); INSERT INTO process_job_rows (job) SELECT j.id FROM process_job_replaced p CROSS JOIN jobs j ON j.id = p.job WHERE (j.state = 'running' AND j.pgid IS NOT NULL) AND NOT EXISTS (SELECT 1 FROM process_job_rows r WHERE r.job = j.id); DELETE FROM process_job_replaced WHERE job IS NOT NULL; INSERT INTO process_job_rows (job) SELECT j.id FROM jobs j WHERE j.rowid = NEW.rowid AND j.id IS NOT NULL AND (j.state = 'running' AND j.pgid IS NOT NULL) AND NOT EXISTS (SELECT 1 FROM process_job_rows p WHERE p.job = j.id); END;",
    "CREATE TRIGGER process_job_drop AFTER DELETE ON jobs WHEN (OLD.state = 'running' AND OLD.pgid IS NOT NULL) BEGIN DELETE FROM process_job_rows WHERE job = OLD.id; END;",
  ]
}

fn process_jobs_installed(db : sql_db::Db) -> Result[Bool, builders_core::StepError] {
  schema_exists(db, "table", "process_job_meta")
}

fn process_jobs_check(db : sql_db::Db) -> Result[Unit, builders_core::StepError] {
  let v = match db.first("SELECT version, complete FROM process_job_meta WHERE id = 1", []) {
    Ok(Some(m)) => sql_db::row_val(m, "version")
    Ok(None) => base_codec::json_null()
    Err(e) => return Err(builders_core::StepError::Sql(e))
  }
  let ok_ver = match v {
    base_codec::Json::Num(n, _) => n.to_int() == JOBS_VERSION
    _ => false
  }
  if !ok_ver {
    let said = if is_json_null(v) { "missing" } else { sql_db::stringify_json(v) }
    return Err(
      builders_core::StepError::App(
        "process job index version " + said + " is incompatible with " + JOBS_VERSION.to_string(),
      ),
    )
  }
  Ok(())
}

pub fn process_jobs_install(db : sql_db::Db) -> Result[Unit, builders_core::StepError] {
  match process_jobs_installed(db) {
    Ok(true) => return process_jobs_check(db)
    Ok(false) => ()
    Err(e) => return Err(e)
  }
  db.tx_err(
    fn(tx_db : sql_db::Db) -> Result[Unit, builders_core::StepError] {
      match process_jobs_installed(tx_db) {
        Ok(false) => {
          let stmts = process_jobs_schema_stmts()
          for i in 0..<stmts.length() {
            match tx_db.exec(stmts[i]) {
              Ok(_) => ()
              Err(e) => return Err(builders_core::StepError::Sql(e))
            }
          }
          let sv = match tx_db.schema_version() {
            Ok(v) => v
            Err(e) => return Err(builders_core::StepError::Sql(e))
          }
          match tx_db.run("UPDATE process_job_meta SET schema_version = ? WHERE id = 1", [sv]) {
            Ok(_) => Ok(())
            Err(e) => Err(builders_core::StepError::Sql(e))
          }
        }
        Ok(true) => process_jobs_check(tx_db)
        Err(e) => Err(e)
      }
    },
    map_sql,
  )
}

pub fn process_jobs_step(db : sql_db::Db, limit : Int = 64) -> Result[Bool, builders_core::StepError] {
  if limit < 1 {
    return Err(builders_core::StepError::App("process job batch must be positive"))
  }
  db.tx_err(
    fn(tx_db : sql_db::Db) -> Result[Bool, builders_core::StepError] {
      match process_jobs_check(tx_db) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let meta = match tx_db.first(
        "SELECT complete, CAST(cursor AS TEXT) AS cursor, CAST(end_rowid AS TEXT) AS end_rowid, schema_version FROM process_job_meta WHERE id = 1",
        [],
      ) {
        Ok(Some(r)) => r
        Ok(None) => return Err(builders_core::StepError::App("process job index metadata is missing"))
        Err(e) => return Err(builders_core::StepError::Sql(e))
      }
      if json_is_one(sql_db::row_val(meta, "complete")) {
        return Ok(true)
      }
      let schema = match tx_db.schema_version() {
        Ok(v) => v
        Err(e) => return Err(builders_core::StepError::Sql(e))
      }
      let (cursor, end) = if !base_codec::json_eq(schema, sql_db::row_val(meta, "schema_version")) {
        let last_pos = match tx_db.first(LAST_RUNNING_SQL, []) {
          Ok(Some(r)) => sql_db::row_val(r, "position")
          Ok(None) => base_codec::json_null()
          Err(e) => return Err(builders_core::StepError::Sql(e))
        }
        (base_codec::json_null(), last_pos)
      } else {
        (sql_db::row_val(meta, "cursor"), sql_db::row_val(meta, "end_rowid"))
      }
      let lim = base_codec::json_num(limit.to_double())
      let rows = if is_json_null(end) {
        []
      } else if is_json_null(cursor) {
        match tx_db.all(
          "SELECT CAST(rowid AS TEXT) AS position FROM jobs INDEXED BY jobs_state WHERE state = 'running' AND rowid <= CAST(? AS INTEGER) ORDER BY rowid LIMIT ?",
          [end, lim],
        ) {
          Ok(r) => r
          Err(e) => return Err(builders_core::StepError::Sql(e))
        }
      } else {
        match tx_db.all(
          "SELECT CAST(rowid AS TEXT) AS position FROM jobs INDEXED BY jobs_state WHERE state = 'running' AND rowid > CAST(? AS INTEGER) AND rowid <= CAST(? AS INTEGER) ORDER BY rowid LIMIT ?",
          [cursor, end, lim],
        ) {
          Ok(r) => r
          Err(e) => return Err(builders_core::StepError::Sql(e))
        }
      }
      let put = "INSERT INTO process_job_rows (job) SELECT j.id FROM jobs j WHERE j.rowid = CAST(? AS INTEGER) AND j.id IS NOT NULL AND (j.state = 'running' AND j.pgid IS NOT NULL) AND NOT EXISTS (SELECT 1 FROM process_job_rows p WHERE p.job = j.id);"
      for i in 0..<rows.length() {
        match tx_db.run(put, [sql_db::row_val(rows[i], "position")]) {
          Ok(_) => ()
          Err(e) => return Err(builders_core::StepError::Sql(e))
        }
      }
      let done = rows.length() < limit
      let reached = if rows.length() > 0 {
        sql_db::row_val(rows[rows.length() - 1], "position")
      } else {
        cursor
      }
      match tx_db.run(
        "UPDATE process_job_meta SET cursor = CAST(? AS INTEGER), end_rowid = CAST(? AS INTEGER), complete = ?, schema_version = ? WHERE id = 1",
        [reached, end, json_flag(done), schema],
      ) {
        Ok(_) => ()
        Err(e) => return Err(builders_core::StepError::Sql(e))
      }
      Ok(done)
    },
    map_sql,
  )
}
