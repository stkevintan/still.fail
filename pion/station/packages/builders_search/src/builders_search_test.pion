// Pure-Pion unit tests for `builders_search` (no C FFI symbols so `pionc test` links cleanly):
// search terms, UTF-16 lone-surrogate excerpting, UTF-16 ordering, visibility (`sees`),
// `script_calls`, `timeline_of` across runtimes, ISO date bounds, `state_json` raw-bytes base64,
// and `tail_utf16` overlap preservation.

import "base_codec"
import "js_json"

fn expect_bs(cond : Bool, msg : String) -> Unit {
  if !cond {
    panic(msg)
  }
}

test "terms splits JS whitespace, lowers with V8 rules, dedupes, caps at 8" {
  let ws = terms("  PLAN\tİstanbul\u{3000}ΟΔΟΣ  plan  ")
  expect_bs(ws.length() == 3, "3 unique terms")
  expect_bs(ws[0] == "plan", "t0")
  expect_bs(ws[1] == "i\u{307}stanbul", "t1 Turkish dotted I")
  expect_bs(ws[2] == "οδο\u{3c2}", "t2 final sigma")
  let capped = terms("a b c d e f g h i j k")
  expect_bs(capped.length() == 8, "capped at 8")
  expect_bs(terms("   \t\n  ").length() == 0, "blank query -> empty")
}

test "excerpt_units slices by UTF-16 code units and preserves lone surrogates until JSON stringify" {
  // 2 'x' + 1 emoji 😀 (units 2, 3) + 79 'a' (units 4..83) + "needle" (at unit 83)
  // from = 83 - 80 = 3 -> flat[3] is 0xDE00 (lone low surrogate)!
  let sb = StringBuilder::new()
  sb.write_string("xx")
  sb.write_string("😀")
  for _ in 0..<79 {
    sb.write_string("a")
  }
  sb.write_string("needle")
  let units = excerpt_units(sb.to_string(), ["needle"])
  expect_bs(units[0] == 0x2026, "leading ellipsis")
  expect_bs(units[1] == 0xDE00, "lone low surrogate preserved at UTF-16 cut")
  let encoded = js_json::stringify_with_num(js_json::JValue::Str(units), fn(d : Double) -> String { d.to_string() })
  expect_bs(encoded.contains("\\ude00"), "serialized lone surrogate escape: " + encoded)
}

test "compare_units uses UTF-16 code unit order (😀 < U+E000) and sees/has check visibility" {
  expect_bs(compare_units("😀", "\u{E000}") < 0, "surrogate pair sorts before U+E000")
  let asker = Asker::{ workspace: "W1", home: true, scopes: ["write"] }
  expect_bs(sees(Some("W1"), None, asker), "own workspace visible")
  expect_bs(sees(Some("*"), Some("write"), asker), "wildcard + matching scope visible")
  expect_bs(!sees(Some("W2"), None, asker), "other workspace hidden")
  expect_bs(!sees(Some("W1"), Some("admin"), asker), "missing scope hidden")
  expect_bs(has("İstanbul ΟΔΟΣ plan", terms("i̇stanbul οδος")), "V8 case-insensitive has")
}

test "script_calls extracts Codex tools.<name>({...}) literals and detects only-calls" {
  let (calls, only) = script_calls("text(await tools.web_search({query: \"deploy \\u00e9\", n: 1e2, ok: true}))")
  expect_bs(calls.length() == 1, "1 call extracted")
  expect_bs(only, "only wrapped tool call")
  let (name, args) = calls[0]
  expect_bs(name == "web_search", "tool name")
  match args.get("query") {
    Some(js_json::JValue::Str(u)) => expect_bs(js_json::sanitize_str(u) == "deploy é", "unescaped query")
    _ => panic("expected query string")
  }
}

test "date_parse strict_day and date_iso range check" {
  expect_bs(
    match date_parse("2026-11-01T10:00:00.123Z") {
      Some(_) => true
      None => false
    },
    "valid ISO parses",
  )
  expect_bs(
    match date_parse("2026-02-30T00:00:00Z") {
      None => true
      Some(_) => false
    },
    "invalid calendar day rejected",
  )
  expect_bs(
    match date_iso(9.0e15) {
      Err(_) => true
      Ok(_) => false
    },
    "out of JS date range rejected",
  )
}

test "state_json encodes raw partial bytes as base64" {
  let raw = Bytes::new(3)
  raw[0] = 0xE2 as Byte
  raw[1] = 0x82 as Byte
  raw[2] = 0x00 as Byte
  let st = TailState::{
    path: "/tmp/t.jsonl",
    runtime: Some("claude"),
    offset: 123.to_int64(),
    partial: raw,
    count: 4,
    inner: [("c1", 2)],
    packed_stamp: None,
  }
  let j = state_json(st)
  let s = base_codec::json_stringify(j)
  expect_bs(s.contains("\"partial\":\"4oIA\""), "raw bytes base64 partial: " + s)
  expect_bs(marks_dir("/", "/data") == "/data/transcript-marks", "marks_dir")
}

test "tail_utf16_units keeps exact trailing 1024 UTF-16 code units including low surrogate 0xDE00 on odd boundary" {
  let sb = StringBuilder::new()
  for _ in 0..<600 {
    sb.write_string("😀") // 2 UTF-16 units each -> 1200 units
  }
  let t = tail_utf16_units(js_json::utf16_units(sb.to_string()), 1024)
  expect_bs(t.length() == 1024, "exact 1024 UTF-16 units")

  // Odd boundary: 😀 (0xD83D, 0xDE00) + 1023 'a' = 1025 UTF-16 units.
  // Aligning with `history.mbt:235`, the trailing 1024 UTF-16 units start with low surrogate 0xDE00!
  let odd = StringBuilder::new()
  odd.write_string("😀")
  for _ in 0..<1023 {
    odd.write_string("a")
  }
  let t_odd = tail_utf16_units(js_json::utf16_units(odd.to_string()), 1024)
  expect_bs(t_odd.length() == 1024, "odd surrogate boundary keeps exact 1024 UTF-16 units, got " + t_odd.length().to_string())
  expect_bs(t_odd[0] == 0xDE00, "first unit at odd surrogate cut must be low surrogate 0xDE00")
  expect_bs(t_odd[1] == 0x61 && t_odd[1023] == 0x61, "remaining 1023 units are 'a'")

  // Parity check: O(max_units) `next_tail_utf16_units` vs full-chunk `tail_utf16_units(concat(...))`
  let eq_units = fn(a : Array[Int], b : Array[Int], label : String) -> Unit {
    expect_bs(a.length() == b.length(), label + " length mismatch: " + a.length().to_string() + " vs " + b.length().to_string())
    for i in 0..<a.length() {
      expect_bs(a[i] == b[i], label + " mismatch at " + i.to_string())
    }
  }
  // Case 1: short chunk concatenated onto existing prev_tail (must pull from prev_tail)
  let prev1 = js_json::utf16_units("prefix😀中文" + odd.to_string())
  let prev1_tail = tail_utf16_units(prev1, 1024)
  let short_chunk = "tail-中文😀end"
  eq_units(
    next_tail_utf16_units(prev1_tail, short_chunk, 1024),
    tail_utf16_units(concat_utf16_units(prev1_tail, js_json::utf16_units(short_chunk)), 1024),
    "short chunk concat",
  )
  // Case 2: >4 KiB multi-byte chunk (3-byte CJK + 4-byte emoji straddling the 4096-byte cut point)
  let big_sb = StringBuilder::new()
  big_sb.write_string("x") // shift UTF-8 alignment by 1 byte
  for _ in 0..<900 {
    big_sb.write_string("中😀") // 7 UTF-8 bytes, 3 UTF-16 units -> 6300 bytes (>4096), 2700 UTF-16 units
  }
  big_sb.write_string("😀")
  for _ in 0..<1023 {
    big_sb.write_string("a") // ends on exact odd surrogate boundary (0xDE00 + 1023 'a')
  }
  let big_chunk = big_sb.to_string()
  let got_big = next_tail_utf16_units(prev1_tail, big_chunk, 1024)
  let ref_big = tail_utf16_units(concat_utf16_units(prev1_tail, js_json::utf16_units(big_chunk)), 1024)
  eq_units(got_big, ref_big, ">4KiB multibyte + odd surrogate boundary")
  expect_bs(got_big.length() == 1024 && got_big[0] == 0xDE00, ">4KiB odd surrogate starts with 0xDE00")
}

fn make_mock_session_row(key : String) -> Map[String, base_codec::Json] {
  let m : Map[String, base_codec::Json] = Map::new()
  m.set("key", base_codec::json_str(key))
  m.set("workspace", base_codec::json_str("/w/" + key))
  m.set("cwd", base_codec::json_null())
  m.set("title", base_codec::json_str("Title " + key))
  m
}

fn mock_pure_format_hit(fields : Array[(String, base_codec::Json)], units : Array[Int]) -> String {
  let text_json = js_json::stringify_with_num(js_json::JValue::Str(units), fn(d : Double) -> String { d.to_string() })
  let sb = StringBuilder::new()
  sb.write_string("{")
  for i in 0..<fields.length() {
    if i > 0 {
      sb.write_string(",")
    }
    let (k, v) = fields[i]
    sb.write_string(base_codec::json_stringify(base_codec::json_str(k)))
    sb.write_string(":")
    if k == "text" {
      sb.write_string(text_json)
    } else {
      sb.write_string(base_codec::json_stringify(v))
    }
  }
  sb.write_string("}")
  sb.to_string()
}

fn mock_pure_parse_line(
  _runtime : String,
  record : js_json::JValue,
  _state : ReadState,
  out : Array[Entry],
) -> Result[Unit, String] {
  match jv_get(Some(record), "type") {
    Some(js_json::JValue::Str(tu)) => {
      if js_json::sanitize_str(tu) == "assistant" {
        match jv_units_of(jv_get(jv_get(Some(record), "message"), "content")) {
          Some(u) => {
            let cu = clip_units(u)
            out.push(make_entry(None, "assistant", js_json::sanitize_str(cu), text_units=Some(cu)))
          }
          None => ()
        }
      }
    }
    _ => ()
  }
  Ok(())
}

test "HistoriesStepper P10/files exit checks keep() on empty-path deadline crossing -> more:true, left:1" {
  let clock = [1000.to_int64()]
  let asker = Asker::{ workspace: "W1", home: true, scopes: [] }
  let stepper = HistoriesStepper::new("/data", "/", ["needle"], asker, 8, 0, clock[0])
  let driver = HistDriver::{
    now_ms: fn() -> Int64 { clock[0] },
    init_sessions: fn() -> Result[Array[Map[String, base_codec::Json]], String] { Ok([make_mock_session_row("s-empty")]) },
    load_profiles: fn() -> Array[(String, String)] { [] },
    check_visible: fn(_k : base_codec::Json) -> Result[Unit, String] { Ok(()) },
    recheck_hits: fn(_hs : Array[base_codec::Json]) -> Result[Unit, String] { Ok(()) },
    history_sources: fn(_k : base_codec::Json) -> Result[Array[Option[(String, String, Option[String])]], String] {
      // One source whose `find_sources` returns [] and advances clock past 15s deadline
      Ok([Some(("r1", "claude", None))])
    },
    find_sources: fn(_d : String, _p : Array[(String, String)], _s : (String, String, Option[String]), _pl : Array[String]) -> Array[(String, String)] {
      // Simulate final finder.sources crossing the 15,000 ms deadline and returning empty paths
      clock[0] = clock[0] + 16000.to_int64()
      []
    },
    text_open: fn(_p : String, _l : Bool) -> Result[Option[base_codec::Json], String] { Ok(None) },
    text_next: fn(_id : base_codec::Json) -> Result[Option[String], String] { Ok(None) },
    text_close: fn(_id : base_codec::Json) -> Unit { () },
    thread_of: fn(_k : base_codec::Json) -> Result[Option[Map[String, base_codec::Json]], String] { Ok(None) },
    parse_line: mock_pure_parse_line,
    format_hit: mock_pure_format_hit,
    double_to_json: fn(d : Double) -> base_codec::Json { base_codec::json_num(d) },
    key_stringify: fn(k : base_codec::Json) -> String { base_codec::json_stringify(k) },
  }
  // Step 1: HistInit -> SessionLoop(0) -> yields at P12
  match stepper.step_with(driver, false) {
    HistStepResult::Yielded => ()
    _ => panic("expected P12 yield")
  }
  // Step 2: AfterSessionPause(0) -> step_files_with -> find_sources crosses deadline with [] -> MUST return partial_result (more:true, left:1)
  match stepper.step_with(driver, false) {
    HistStepResult::Finished(Some(grp)) => {
      expect_bs(grp.contains("\"more\":true"), "expected more:true on empty-path deadline crossing: " + grp)
      expect_bs(grp.contains("\"left\":1"), "expected left:1 on empty-path deadline crossing: " + grp)
    }
    other => panic("expected Finished(Some(partial)) on empty-path deadline crossing")
  }
}

test "HistoriesStepper P11 interleaved A/B cancel + tail overlap + exact-once text.close across all 5 exit paths" {
  let clock = [5000.to_int64()]
  let next_id = [1]
  let open_state : Map[Int, Bool] = Map::new()
  let close_counts : Map[Int, Int] = Map::new()
  let chunk_cursor : Map[Int, Int] = Map::new()
  let handle_chunks : Map[Int, Array[Result[Option[String], String]]] = Map::new()
  let file_chunks : Map[String, Array[Result[Option[String], String]]] = Map::new()

  // File A: 3 chunks, match only in chunk 3 (so chunk 1 yields at P11)
  file_chunks.set("/a.jsonl", [
    Ok(Some("{\"type\":\"assistant\",\"message\":{\"content\":\"filler a1\"}}\n")),
    Ok(Some("{\"type\":\"assistant\",\"message\":{\"content\":\"filler a2\"}}\n")),
    Ok(Some("{\"type\":\"assistant\",\"message\":{\"content\":\"alphaonly\"}}\n")),
    Ok(None),
  ])
  // File B: keyword 1 ("betakey") sits strictly OUTSIDE the 1024-unit tail overlap (>1200 chars before chunk 1 end),
  // so resetting `ms.left` on chunk 2 would guarantee failure! Keyword 2 ("crossbound") is split across chunk 1/2.
  let pad_sb = StringBuilder::new()
  for _ in 0..<1200 {
    pad_sb.write_string("f")
  }
  let b_part1 = "{\"type\":\"assistant\",\"message\":{\"content\":\"betakey " + pad_sb.to_string() + " cross"
  let b_part2 = "bound end\"}}\n"
  file_chunks.set("/b.jsonl", [
    Ok(Some(b_part1)),
    Ok(Some(b_part2)),
    Ok(None),
  ])
  // File B lines=true read for collect_session_entries
  file_chunks.set("/b.jsonl#lines", [
    Ok(Some(b_part1 + b_part2)),
    Ok(None),
  ])
  // File E: read error on chunk 2
  file_chunks.set("/err.jsonl", [
    Ok(Some("{\"type\":\"assistant\",\"message\":{\"content\":\"filler e1\"}}\n")),
    Err("EIO"),
  ])

  let make_driver = fn(sess_key : String, path : String) -> HistDriver {
    HistDriver::{
      now_ms: fn() -> Int64 { clock[0] },
      init_sessions: fn() -> Result[Array[Map[String, base_codec::Json]], String] { Ok([make_mock_session_row(sess_key)]) },
      load_profiles: fn() -> Array[(String, String)] { [] },
      check_visible: fn(_k : base_codec::Json) -> Result[Unit, String] { Ok(()) },
      recheck_hits: fn(_hs : Array[base_codec::Json]) -> Result[Unit, String] { Ok(()) },
      history_sources: fn(_k : base_codec::Json) -> Result[Array[Option[(String, String, Option[String])]], String] {
        Ok([Some(("r1", "claude", None))])
      },
      find_sources: fn(_d : String, _p : Array[(String, String)], _s : (String, String, Option[String]), _pl : Array[String]) -> Array[(String, String)] {
        [(path, "claude")]
      },
      text_open: fn(p : String, lines : Bool) -> Result[Option[base_codec::Json], String] {
        let id = next_id[0]
        next_id[0] = id + 1
        open_state.set(id, true)
        close_counts.set(id, 0)
        chunk_cursor.set(id, 0)
        let lookup = if lines {
          match file_chunks.get(p + "#lines") {
            Some(c) => c
            None => match file_chunks.get(p) {
              Some(c2) => c2
              None => [Ok(None)]
            }
          }
        } else {
          match file_chunks.get(p) {
            Some(c) => c
            None => [Ok(None)]
          }
        }
        handle_chunks.set(id, lookup)
        Ok(Some(base_codec::json_int(id)))
      },
      text_next: fn(hid : base_codec::Json) -> Result[Option[String], String] {
        let id = match hid {
          base_codec::Json::Num(n, _) => n.to_int()
          _ => panic("bad handle id")
        }
        expect_bs(
          match open_state.get(id) {
            Some(true) => true
            _ => false
          },
          "text.next called on closed handle " + id.to_string(),
        )
        let cur = match chunk_cursor.get(id) {
          Some(c) => c
          None => 0
        }
        let arr = match handle_chunks.get(id) {
          Some(a) => a
          None => [Ok(None)]
        }
        if cur >= arr.length() {
          return Ok(None)
        }
        chunk_cursor.set(id, cur + 1)
        arr[cur]
      },
      text_close: fn(hid : base_codec::Json) -> Unit {
        let id = match hid {
          base_codec::Json::Num(n, _) => n.to_int()
          _ => panic("bad handle id")
        }
        open_state.set(id, false)
        let prev = match close_counts.get(id) {
          Some(c) => c
          None => 0
        }
        close_counts.set(id, prev + 1)
      },
      thread_of: fn(_k : base_codec::Json) -> Result[Option[Map[String, base_codec::Json]], String] { Ok(None) },
      parse_line: mock_pure_parse_line,
      format_hit: mock_pure_format_hit,
      double_to_json: fn(d : Double) -> base_codec::Json { base_codec::json_num(d) },
      key_stringify: fn(k : base_codec::Json) -> String { base_codec::json_stringify(k) },
    }
  }

  let asker = Asker::{ workspace: "W1", home: true, scopes: [] }

  // 1 & 2. Interleaved A and B both pause at P11 holding distinct open_text_id; cancel A -> A closes immediately, B finishes via tail overlap!
  let drvA = make_driver("s-a", "/a.jsonl")
  let drvB = make_driver("s-b", "/b.jsonl")
  let stA = HistoriesStepper::new("/data", "/", ["alphaonly"], asker, 8, 0, clock[0])
  let stB = HistoriesStepper::new("/data", "/", ["betakey", "crossbound"], asker, 8, 0, clock[0])

  // P12 yield for both A and B
  expect_bs(match stA.step_with(drvA, false) { HistStepResult::Yielded => true; _ => false }, "A P12")
  expect_bs(match stB.step_with(drvB, false) { HistStepResult::Yielded => true; _ => false }, "B P12")
  // P11 yield for both A and B (both now hold open handles!)
  expect_bs(match stA.step_with(drvA, false) { HistStepResult::Yielded => true; _ => false }, "A P11")
  expect_bs(match stB.step_with(drvB, false) { HistStepResult::Yielded => true; _ => false }, "B P11")
  let idA = match stA.open_text_id {
    Some(base_codec::Json::Num(n, _)) => n.to_int()
    _ => panic("A must hold open_text_id at P11")
  }
  let idB = match stB.open_text_id {
    Some(base_codec::Json::Num(n, _)) => n.to_int()
    _ => panic("B must hold open_text_id at P11")
  }
  let get_count = fn(id : Int) -> Int {
    match close_counts.get(id) {
      Some(c) => c
      None => -1
    }
  }
  let is_open = fn(id : Int) -> Bool {
    match open_state.get(id) {
      Some(b) => b
      None => false
    }
  }
  expect_bs(idA != idB, "A and B hold distinct handles")
  expect_bs(get_count(idA) == 0 && get_count(idB) == 0, "neither closed yet")

  // Cancel A mid-P11!
  match stA.step_with(drvA, true) {
    HistStepResult::Failed(msg) => expect_bs(msg == "the search took too long", "cancel error: " + msg)
    _ => panic("expected A cancel failure")
  }
  expect_bs(match stA.open_text_id { None => true; _ => false }, "A open_text_id cleared")
  expect_bs(get_count(idA) == 1, "A handle closed exactly once")
  expect_bs(!is_open(idA), "A handle closed in table")
  expect_bs(is_open(idB), "B handle still open")

  // Continue B: chunk 2 completes "crossbound" via tail overlap -> normal completion!
  match stB.step_with(drvB, false) {
    HistStepResult::Finished(Some(grp)) => {
      expect_bs(grp.contains("crossbound") || grp.contains("betakey"), "B matched via tail overlap: " + grp)
    }
    _ => panic("expected B to succeed with hit")
  }
  expect_bs(match stB.open_text_id { None => true; _ => false }, "B open_text_id cleared")

  // 3. 15s timeout mid-P11
  let drvT = make_driver("s-t", "/a.jsonl")
  let stT = HistoriesStepper::new("/data", "/", ["alphaonly"], asker, 8, 0, clock[0])
  expect_bs(match stT.step_with(drvT, false) { HistStepResult::Yielded => true; _ => false }, "T P12")
  expect_bs(match stT.step_with(drvT, false) { HistStepResult::Yielded => true; _ => false }, "T P11")
  clock[0] = clock[0] + 16000.to_int64()
  match stT.step_with(drvT, false) {
    HistStepResult::Finished(Some(grp)) => {
      expect_bs(grp.contains("\"more\":true") && grp.contains("\"left\":1"), "timeout partial: " + grp)
    }
    _ => panic("expected 15s timeout partial")
  }

  // 4. Read error mid-P11
  let drvE = make_driver("s-e", "/err.jsonl")
  let stE = HistoriesStepper::new("/data", "/", ["alphaonly"], asker, 8, 0, clock[0])
  expect_bs(match stE.step_with(drvE, false) { HistStepResult::Yielded => true; _ => false }, "E P12")
  expect_bs(match stE.step_with(drvE, false) { HistStepResult::Yielded => true; _ => false }, "E P11")
  expect_bs(match stE.step_with(drvE, false) { HistStepResult::Finished(None) => true; _ => false }, "E finishes cleanly on read error")

  // 5. Real scheduler stdin EOF entrypoint (`dispatch_eof`) while paused at P11 (and idempotent second call)
  let drvF = make_driver("s-f", "/a.jsonl")
  let stF = HistoriesStepper::new("/data", "/", ["alphaonly"], asker, 8, 0, clock[0])
  expect_bs(match stF.step_with(drvF, false) { HistStepResult::Yielded => true; _ => false }, "F P12")
  expect_bs(match stF.step_with(drvF, false) { HistStepResult::Yielded => true; _ => false }, "F P11")
  let active_eof : Array[HistoriesStepper] = [stF]
  dispatch_eof(active_eof, fn(s : HistoriesStepper) -> Unit { s.close_text_handle_with(drvF.text_close) })
  expect_bs(active_eof.length() == 0, "dispatch_eof drains active queue")
  dispatch_eof(active_eof, fn(s : HistoriesStepper) -> Unit { s.close_text_handle_with(drvF.text_close) }) // idempotent!

  // Assert EVERY handle opened across all 5 exit paths was closed EXACTLY ONCE (0 leaks, 0 double-closes)
  let total_opened = next_id[0] - 1
  expect_bs(total_opened >= 6, "expected >= 6 handles opened across 5 exit paths, got " + total_opened.to_string())
  for id in 1..<(total_opened + 1) {
    expect_bs(
      get_count(id) == 1,
      "handle " + id.to_string() + " close count != 1",
    )
    expect_bs(
      !is_open(id),
      "handle " + id.to_string() + " still open",
    )
  }
}
