// 1:1 port of `station/mb/src/history/entries.mbt`:
// Per-runtime timeline extractors (`dsh`, `pi`, `grok`, `cursor`, `claude`, `codex`),
// `brief_of` / `brief` (by Unicode code points), and `entry_json`.

import "base_codec"
import "js_json"
import "jscase"
import "sql_db"

fn make_entry(
  at : Option[String],
  kind : String,
  text : String,
  text_units : Option[Array[Int]] = None,
  tool : Option[String] = None,
  ok : Option[Bool] = None,
  call_id : Option[String] = None,
  subagent : Bool = false,
  said : Option[String] = None,
  in_script : Bool = false,
) -> Entry {
  Entry::{
    at: at,
    kind: kind,
    text: text,
    text_units: text_units,
    tool: tool,
    ok: ok,
    call_id: call_id,
    subagent: subagent,
    said: said,
    in_script: in_script,
  }
}

/// First `n` Unicode code points of `text`.
fn first_chars(text : String, n : Int) -> String {
  let cs = js_json::points(text)
  if cs.length() <= n {
    return text
  }
  let sb = StringBuilder::new()
  for i in 0..<n {
    sb.write_string(cs[i])
  }
  sb.to_string()
}

