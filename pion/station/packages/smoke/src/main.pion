      Some("usage-check") => {
        match flag_value(argv, "--db") {
          Some(db_path) => host_shim::exit_process(builders_requested::run_usage_check(db_path))
          None => usage_exit()
        }
      }
      Some("live-locator") => {
        match (flag_value(argv, "--db"), flag_value(argv, "--data")) {
          (Some(db_path), Some(data_dir)) => {
            let sep = match flag_value(argv, "--sep") {
              Some(s) => s
              None => "/"
            }
            host_shim::exit_process(locate::run_live_locator(db_path, data_dir, sep))
          }
          _ => usage_exit()
