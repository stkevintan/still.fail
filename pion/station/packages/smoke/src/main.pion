      Some("usage-counter") => {
        match flag_value(argv, "--db") {
          Some(db_path) => {
            let sep = match flag_value(argv, "--sep") {
              Some(s) => s
              None => "/"
            }
            host_shim::exit_process(builders_usage::run_usage_counter(db_path, sep))
          }
          None => usage_exit()
        }
      }
      Some("search") => {
        match (flag_value(argv, "--db"), flag_value(argv, "--data")) {
          (Some(db_path), Some(data_dir)) => {
            let sep = match flag_value(argv, "--sep") {
              Some(s) => s
              None => "/"
            }
            host_shim::exit_process(builders_search::run_search(db_path, data_dir, sep))
          }
          _ => usage_exit()
        }
      }
      _ => usage_exit()
    }
  }
}
