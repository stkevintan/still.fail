// Paths made as Node's `path.posix` and `path.win32` make them, 1:1 aligned with
// `station/mb/src/nodepath/nodepath.mbt` and `pkg.generated.mbti`.
// Public API is strictly the 6 exported functions:
//   basename, dirname, is_absolute, join, relative_parts, with_extension (`normalize` is private).

fn is_sep(c : Int, win : Bool) -> Bool {
  c == 47 || (win && c == 92) // '/' or '\\'
}

fn is_alpha(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

fn byte_at(s : String, i : Int) -> Int {
  s.code_unit_at(i) & 0xFF
}

fn slice_str(s : String, start : Int, end : Int) -> String {
  if start >= end {
    return ""
  }
  let raw = s.to_bytes()
  let sb = StringBuilder::new()
  for i in start..<end {
    sb.write_byte(raw[i])
  }
  sb.to_string()
}

fn str_contains_byte(s : String, target : Int) -> Bool {
  let n = s.length()
  for i in 0..<n {
    if byte_at(s, i) == target {
      return true
    }
  }
  false
}

fn str_replace_slash_to_backslash(s : String) -> String {
  let raw = s.to_bytes()
  let sb = StringBuilder::new()
  for i in 0..<raw.length() {
    let b = raw[i].to_int() & 0xFF
    if b == 47 {
      sb.write_byte(92 as Byte)
    } else {
      sb.write_byte(raw[i])
    }
  }
  sb.to_string()
}

fn join_arr(parts : Array[String], sep : String) -> String {
  let sb = StringBuilder::new()
  for i in 0..<parts.length() {
    if i > 0 {
      sb.write_string(sep)
    }
    sb.write_string(parts[i])
  }
  sb.to_string()
}

fn is_drive(path : String) -> Bool {
  path.length() >= 2 && is_alpha(byte_at(path, 0)) && byte_at(path, 1) == 58 // ':'
}

fn is_win_reserved_name(s : String, colon : Int) -> Bool {
  // colon is the byte offset of ':' in `s`.
  // 3-char reserved: CON, PRN, AUX, NUL (all ASCII -> colon == 3)
  // 4-char reserved: COM/LPT + ('1'..'9' -> colon == 4, or U+00B9/U+00B2/U+00B3 in UTF-8 0xC2 0xB9/B2/B3 -> colon == 5)
  if colon != 3 && colon != 4 && colon != 5 {
    return false
  }
  let c0_raw = byte_at(s, 0)
  let c1_raw = byte_at(s, 1)
  let c2_raw = byte_at(s, 2)
  let c0 = if c0_raw >= 97 && c0_raw <= 122 { c0_raw - 32 } else { c0_raw }
  let c1 = if c1_raw >= 97 && c1_raw <= 122 { c1_raw - 32 } else { c1_raw }
  let c2 = if c2_raw >= 97 && c2_raw <= 122 { c2_raw - 32 } else { c2_raw }
  if colon == 3 {
    (c0 == 67 && c1 == 79 && c2 == 78) || // CON
    (c0 == 80 && c1 == 82 && c2 == 78) || // PRN
    (c0 == 65 && c1 == 85 && c2 == 88) || // AUX
    (c0 == 78 && c1 == 85 && c2 == 76) // NUL
  } else if colon == 4 {
    let c3 = byte_at(s, 3)
    let digit = c3 >= 49 && c3 <= 57 // '1'..'9'
    digit && ((c0 == 67 && c1 == 79 && c2 == 77) || (c0 == 76 && c1 == 80 && c2 == 84))
  } else {
    // colon == 5: UTF-8 2-byte superscript 1/2/3 (0xC2 0xB9 / 0xB2 / 0xB3)
    let b3 = byte_at(s, 3)
    let b4 = byte_at(s, 4)
    let digit = b3 == 0xC2 && (b4 == 0xB9 || b4 == 0xB2 || b4 == 0xB3)
    digit && ((c0 == 67 && c1 == 79 && c2 == 77) || (c0 == 76 && c1 == 80 && c2 == 84))
  }
}

fn has_win_reserved_part(joined : String) -> Bool {
  let n = joined.length()
  let mut i = 0
  while i < n {
    while i < n && byte_at(joined, i) == 92 {
      i = i + 1
    }
    let start = i
    let mut colon = -1
    while i < n && byte_at(joined, i) != 92 {
      if colon < 0 && byte_at(joined, i) == 58 {
        colon = i - start
      }
      i = i + 1
    }
    if colon > 0 && is_win_reserved_name(slice_str(joined, start, i), colon) {
      return true
    }
  }
  false
}

/// `path.win32.join`: separators that only met where the parts were joined (`\` and `a`) make no share (`\\a`),
/// so the leading ones are collapsed to one unless the first part began a share itself.
fn not_a_share(first : String, joined : String) -> String {
  let n = first.length()
  let mut leading = 0
  if n > 0 && is_sep(byte_at(first, 0), true) {
    leading = 1
    if n > 1 && is_sep(byte_at(first, 1), true) {
      leading = 2
      if n > 2 {
        if !is_sep(byte_at(first, 2), true) {
          return joined
        }
        leading = 3
      }
    }
  }
  while leading < joined.length() && is_sep(byte_at(joined, leading), true) {
    leading = leading + 1
  }
  if leading >= 2 {
    "\\" + slice_str(joined, leading, joined.length())
  } else {
    joined
  }
}

/// Node's `path.normalize` (private, matching `pkg.generated.mbti`).
fn normalize(sep : String, path : String) -> String {
  let win = sep == "\\"
  let n = path.length()
  if n == 0 {
    return "."
  }
  let mut device = ""
  let mut is_abs = false
  let mut at = 0
  if win {
    if is_sep(byte_at(path, 0), true) {
      is_abs = true
      if n >= 2 && is_sep(byte_at(path, 1), true) {
        if n > 2 && !is_sep(byte_at(path, 2), true) {
          let mut j = 2
          while j < n && !is_sep(byte_at(path, j), true) {
            j = j + 1
          }
          let host = slice_str(path, 2, j)
          let sep_start = j
          while j < n && is_sep(byte_at(path, j), true) {
            j = j + 1
          }
          if j > sep_start && j < n {
            let share_start = j
            while j < n && !is_sep(byte_at(path, j), true) {
              j = j + 1
            }
            let share = slice_str(path, share_start, j)
            device = "\\\\" + host + "\\" + share
            at = j
          } else {
            at = 2
          }
        } else {
          at = 2
        }
      } else {
        at = 1
      }
    } else if is_drive(path) {
      device = slice_str(path, 0, 2)
      if n > 2 && is_sep(byte_at(path, 2), true) {
        is_abs = true
        at = 3
      } else {
        at = 2
      }
    }
  } else if byte_at(path, 0) == 47 {
    is_abs = true
    at = 1
  }
  let parts : Array[String] = []
  let mut start = at
  let mut i = at
  while i <= n {
    if i < n && !is_sep(byte_at(path, i), win) {
      i = i + 1
      continue
    }
    let part = slice_str(path, start, i)
    start = i + 1
    i = i + 1
    if part == "" || part == "." {
      continue
    }
    if part == ".." {
      if parts.length() > 0 && parts[parts.length() - 1] != ".." {
        let _ = parts.pop()
      } else if !is_abs {
        parts.push(part)
      }
      continue
    }
    parts.push(part)
  }
  let mut tail = join_arr(parts, sep)
  let trailing = n > 0 && is_sep(byte_at(path, n - 1), win)
  if tail == "" && !is_abs {
    tail = "."
  }
  if tail != "" && trailing {
    tail = tail + sep
  }
  if win && device == "" && !is_abs && str_contains_byte(path, 58) {
    if is_drive(tail) {
      return ".\\" + tail
    }
    for k in 0..<n {
      if byte_at(path, k) == 58 && (k == n - 1 || is_sep(byte_at(path, k + 1), true)) {
        return ".\\" + tail
      }
    }
  }
  if device == "" {
    if is_abs { sep + tail } else { tail }
  } else if is_abs {
    device + "\\" + tail
  } else {
    device + tail
  }
}

/// Node's `path.join`: parts joined with `sep`, then normalized.
pub fn join(sep : String, parts : Array[String]) -> String {
  let given : Array[String] = []
  for i in 0..<parts.length() {
    if parts[i] != "" {
      given.push(parts[i])
    }
  }
  let mut joined = join_arr(given, sep)
  if sep == "\\" && given.length() > 0 {
    joined = not_a_share(given[0], joined)
    if has_win_reserved_part(joined) {
      return str_replace_slash_to_backslash(joined)
    }
  }
  normalize(sep, if joined == "" { "." } else { joined })
}

fn root_length(path : String, win : Bool) -> Int {
  let n = path.length()
  if !win {
    return if n > 0 && byte_at(path, 0) == 47 { 1 } else { 0 }
  }
  if is_drive(path) {
    return if n > 2 && is_sep(byte_at(path, 2), true) { 3 } else { 2 }
  }
  if n == 0 || !is_sep(byte_at(path, 0), true) {
    return 0
  }
  if n >= 2 && is_sep(byte_at(path, 1), true) {
    let mut i = 2
    let mut names = 0
    while i < n && names < 2 {
      let start = i
      while i < n && !is_sep(byte_at(path, i), true) {
        i = i + 1
      }
      if i == start {
        return 1
      }
      names = names + 1
      if names < 2 {
        if i == n {
          return 1
        }
        i = i + 1
      }
    }
    if names == 2 {
      return if i < n { i + 1 } else { i }
    }
  }
  1
}

/// Node's `path.dirname`.
pub fn dirname(sep : String, path : String) -> String {
  let win = sep == "\\"
  let root = root_length(path, win)
  let mut i = path.length() - 1
  while i >= root && is_sep(byte_at(path, i), win) {
    i = i - 1
  }
  while i >= root && !is_sep(byte_at(path, i), win) {
    i = i - 1
  }
  if i < root {
    return if root > 0 { slice_str(path, 0, root) } else { "." }
  }
  if !win && root == 1 && i == 1 {
    return "//"
  }
  slice_str(path, 0, i)
}

/// Node's `path.basename`.
pub fn basename(sep : String, path : String) -> String {
  let win = sep == "\\"
  let start_min = if win && is_drive(path) { 2 } else { 0 }
  let mut end = path.length()
  while end > start_min && is_sep(byte_at(path, end - 1), win) {
    end = end - 1
  }
  let mut start = end
  while start > start_min && !is_sep(byte_at(path, start - 1), win) {
    start = start - 1
  }
  slice_str(path, start, end)
}

/// Replace (or add) file extension, joined again as Node joins.
pub fn with_extension(sep : String, path : String, ext : String) -> String {
  let name = basename(sep, path)
  let mut dot = -1
  let mut i = name.length() - 1
  while i >= 0 {
    if byte_at(name, i) == 46 {
      dot = i
      break
    }
    i = i - 1
  }
  let stem = if dot > 0 { slice_str(name, 0, dot) } else { name }
  join(sep, [dirname(sep, path), stem + "." + ext])
}

/// Relative path components (None for rooted paths or paths containing `..`).
pub fn relative_parts(sep : String, path : String) -> Option[Array[String]] {
  let win = sep == "\\"
  let n = path.length()
  if n == 0 || byte_at(path, 0) == 47 || (win && (byte_at(path, 0) == 92 || str_contains_byte(path, 58))) {
    return None
  }
  let parts : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i < n && !is_sep(byte_at(path, i), win) {
      i = i + 1
      continue
    }
    let part = slice_str(path, start, i)
    if part == ".." {
      return None
    }
    parts.push(part)
    start = i + 1
    i = i + 1
  }
  Some(parts)
}

/// Node's `path.isAbsolute`.
pub fn is_absolute(sep : String, path : String) -> Bool {
  let win = sep == "\\"
  let n = path.length()
  if n > 0 && is_sep(byte_at(path, 0), win) {
    return true
  }
  if !win || n < 3 || byte_at(path, 1) != 58 || !is_sep(byte_at(path, 2), true) {
    return false
  }
  is_alpha(byte_at(path, 0))
}
