// 1:1 port of `station/mb/src/readops/machine.mbt:240-299` (`parse_iso`) and
// `station/mb/src/readops/usage.mbt:7-18,55-101,113-173` (`usage_turns` + private deps).

import "base_codec"
import "builders_core"
import "js_json"
import "sql_db"

pub let MIN_SAFE : Double = -9007199254740991.0

pub let MAX_SAFE : Double = 9007199254740991.0

let TURNS_FROM_SQL : String = "SELECT IFNULL((SELECT MAX(started_at) FROM turns WHERE session_key = ?1 AND started_at <= ?2), (SELECT MIN(started_at) FROM turns WHERE session_key = ?1)) AS at"

let TURNS_BETWEEN_SQL : String = "SELECT id, kind, started_at, profile, person, thread FROM turns WHERE session_key = ?1 AND started_at >= ?2 AND started_at <= ?3 ORDER BY started_at"

let TAKEN_SINCE_SQL : String = "SELECT d.delivered_at AS at, CASE WHEN t.surface = ?2 THEN e.author ELSE 'slack:' || ts.connect || ':' || e.author END AS who, e.thread AS thread FROM deliveries d JOIN entries e ON e.thread = d.thread AND e.n = d.n JOIN threads t ON t.id = d.thread JOIN thread_sessions ts ON ts.thread = d.thread AND ts.session = d.session WHERE d.session = ?1 AND d.delivered_at IS NOT NULL AND d.delivered_at >= ?3 AND e.author_kind = 'person' ORDER BY d.delivered_at"

fn iso_num(b : Bytes, from : Int, len : Int) -> Option[Int64] {
  if from + len > b.length() || len == 0 {
    return None
  }
  let mut i = from
  let mut sign = 1.to_int64()
  let first = b[i].to_int() & 0xFF
  if first == 43 || first == 45 {
    sign = if first == 45 { (-1).to_int64() } else { 1.to_int64() }
    i = i + 1
  }
  if i >= from + len {
    return None
  }
  let mut n = 0.to_int64()
  let ten = 10.to_int64()
  while i < from + len {
    let c = b[i].to_int() & 0xFF
    if c < 48 || c > 57 {
      return None
    }
    n = n * ten + (c - 48).to_int64()
    i = i + 1
  }
  Some(sign * n)
}

/// `readops/machine.mbt:272-299` (`parse_iso`): milliseconds of an ISO time
/// (`YYYY-MM-DDTHH:MM:SS[.fff]`), read strictly by UTF-8 byte positions + `js_json::days_from_civil`.
/// Independent from `js_json::js_parse_iso`.
pub fn parse_iso(at : String) -> Option[Double] {
  let b = js_json::utf8_bytes(at)
  let y = match iso_num(b, 0, 4) {
    Some(v) => v
    None => return None
  }
  let mo = match iso_num(b, 5, 2) {
    Some(v) => v
    None => return None
  }
  let d = match iso_num(b, 8, 2) {
    Some(v) => v
    None => return None
  }
  let h = match iso_num(b, 11, 2) {
    Some(v) => v
    None => return None
  }
  let mi = match iso_num(b, 14, 2) {
    Some(v) => v
    None => return None
  }
  let s = match iso_num(b, 17, 2) {
    Some(v) => v
    None => return None
  }
  let mut ms = 0.to_int64()
  if b.length() > 19 && (b[19].to_int() & 0xFF) == 46 {
    let mut digits = 0
    let mut i = 20
    let ten = 10.to_int64()
    while i < b.length() {
      let c = b[i].to_int() & 0xFF
      if c >= 48 && c <= 57 {
        if digits < 3 {
          ms = ms * ten + (c - 48).to_int64()
          digits = digits + 1
        }
        i = i + 1
      } else {
        break
      }
    }
    while digits < 3 {
      ms = ms * ten
      digits = digits + 1
    }
  }
  let days = js_json::days_from_civil(y.to_int(), mo.to_int(), d.to_int())
  let total_s = days * 86400.to_int64() + h * 3600.to_int64() + mi * 60.to_int64() + s
  Some((total_s * 1000.to_int64() + ms).to_double())
}

fn nan_val() -> Double {
  0.0 / 0.0
}

fn is_nan(d : Double) -> Bool {
  d != d
}

fn abs_d(d : Double) -> Double {
  if d < 0.0 { -d } else { d }
}

fn or_else(a : base_codec::Json, b : base_codec::Json) -> base_codec::Json {
  match a {
    base_codec::Json::Null => b
    _ => a
  }
}

fn parsed_number(s : String) -> base_codec::Json {
  if builders_core::has_lone_surrogate(s) {
    return base_codec::json_num(nan_val())
  }
  match sql_db::parse_json(s) {
    base_codec::JsonParseResult::Ok(base_codec::Json::Num(d, r)) => base_codec::Json::Num(d, r)
    _ => base_codec::json_num(nan_val())
  }
}

pub fn arg_number(v : Option[base_codec::Json]) -> base_codec::Json {
  match v {
    Some(base_codec::Json::Num(d, r)) => base_codec::Json::Num(d, r)
    Some(base_codec::Json::Str(s)) => parsed_number(s)
    Some(base_codec::Json::Null) => base_codec::json_num(0.0)
    Some(base_codec::Json::Bool(true)) => base_codec::json_num(1.0)
    Some(base_codec::Json::Bool(false)) => base_codec::json_num(0.0)
    _ => base_codec::json_num(nan_val())
  }
}

pub fn text_arg_with(v : Option[base_codec::Json], stringify : (base_codec::Json) -> String) -> String {
  match v {
    Some(base_codec::Json::Str(s)) => s
    Some(base_codec::Json::Num(n, r)) => {
      if !sql_db::is_nan_or_inf(n) && n == floor_d(n) && abs_d(n) < 1.0e21 {
        builders_core::double_to_i64_saturating(n).to_string()
      } else {
        stringify(base_codec::Json::Num(n, r))
      }
    }
    Some(base_codec::Json::Null) => "null"
    Some(base_codec::Json::Bool(true)) => "true"
    Some(base_codec::Json::Bool(false)) => "false"
    None => "undefined"
    Some(other) => stringify(other)
  }
}

pub fn text_arg(v : Option[base_codec::Json]) -> String {
  text_arg_with(v, sql_db::stringify_json)
}

fn row_field(row : Map[String, base_codec::Json], k : String) -> base_codec::Json {
  match row.get(k) {
    Some(v) => v
    None => base_codec::json_null()
  }
}

fn db_one(
  db : sql_db::Db,
  sql : String,
  params : Array[base_codec::Json],
) -> Result[Option[Map[String, base_codec::Json]], String] {
  match db.first(sql, params) {
    Ok(r) => Ok(r)
    Err(e) => Err(e.message)
  }
}

struct DeliveredRow {
  at : Double
  who : base_codec::Json
  thread : base_codec::Json
}

struct TurnOut {
  id : base_codec::Json
  started_at : base_codec::Json
  turn : base_codec::Json
  person : base_codec::Json
  thread : base_codec::Json
  profile : base_codec::Json
}

/// 1:1 port of `station/mb/src/readops/usage.mbt:98-173` (`usage_turns`).
/// Takes `args : base_codec::Json` directly in memory so `until` may hold `NaN`
/// (`Json::Num(NaN, "")`) without ever round-tripping through JSON text.
pub fn usage_turns(db : sql_db::Db, args : base_codec::Json) -> Result[base_codec::Json, String] {
  let session = base_codec::json_str(text_arg(builders_core::json_get_last(args, "session")))
  let from = arg_number(builders_core::json_get_last(args, "from"))
  let until = arg_number(builders_core::json_get_last(args, "until"))

  let (creator, profile) = match db_one(db, "SELECT created_by, profile FROM sessions WHERE key = ?", [session]) {
    Ok(Some(r)) => (row_field(r, "created_by"), row_field(r, "profile"))
    Ok(None) => (base_codec::json_null(), base_codec::json_str(""))
    Err(e) => return Err(e)
  }
  let home = match db_one(
    db,
    "SELECT id FROM threads WHERE home = ?1 UNION ALL SELECT thread FROM (SELECT thread FROM thread_sessions WHERE session = ?1 ORDER BY joined_at LIMIT 1) LIMIT 1",
    [session],
  ) {
    Ok(Some(r)) => row_field(r, "id")
    Ok(None) => base_codec::json_null()
    Err(e) => return Err(e)
  }
  let begins = match db_one(db, TURNS_FROM_SQL, [session, from]) {
    Ok(Some(r)) => row_field(r, "at")
    Ok(None) => base_codec::json_null()
    Err(e) => return Err(e)
  }
  let turns : Array[Map[String, base_codec::Json]] = match begins {
    base_codec::Json::Num(b, _) => {
      let upto = match until {
        base_codec::Json::Num(u, _) => {
          if u > b || is_nan(u) {
            until
          } else {
            begins
          }
        }
        _ => begins
      }
      match db.all(TURNS_BETWEEN_SQL, [session, begins, upto]) {
        Ok(rs) => rs
        Err(e) => return Err(e.message)
      }
    }
    _ => []
  }

  let mut any_null_person = false
  for i in 0..<turns.length() {
    match row_field(turns[i], "person") {
      base_codec::Json::Null => {
        any_null_person = true
        break
      }
      _ => ()
    }
  }
  let delivered : Array[DeliveredRow] = []
  if any_null_person {
    let rows = match db.all(TAKEN_SINCE_SQL, [session, base_codec::json_str("chat"), begins]) {
      Ok(rs) => rs
      Err(e) => return Err(e.message)
    }
    for i in 0..<rows.length() {
      let r = rows[i]
      let at_v = match row_field(r, "at") {
        base_codec::Json::Num(a, _) => a
        _ => 0.0
      }
      delivered.push(DeliveredRow::{ at: at_v, who: row_field(r, "who"), thread: row_field(r, "thread") })
    }
  }

  let out : Array[TurnOut] = []
  let mut next = 0
  for n in 0..<turns.length() {
    let t = turns[n]
    let started = match row_field(t, "started_at") {
      base_codec::Json::Num(s, _) => s
      _ => 0.0
    }
    let end = if n + 1 < turns.length() {
      match row_field(turns[n + 1], "started_at") {
        base_codec::Json::Num(s, _) => s
        _ => 0.0
      }
    } else {
      MAX_SAFE
    }
    while next < delivered.length() && delivered[next].at < started {
      next = next + 1
    }
    let is_input = match row_field(t, "kind") {
      base_codec::Json::Str("input") => true
      _ => false
    }
    let first : Option[DeliveredRow] = if is_input && next < delivered.length() && delivered[next].at < end {
      Some(delivered[next])
    } else {
      None
    }
    let prev_person = if out.length() > 0 { or_else(out[out.length() - 1].person, creator) } else { creator }
    let prev_thread = if out.length() > 0 { or_else(out[out.length() - 1].thread, home) } else { home }
    let person = or_else(
      row_field(t, "person"),
      match first {
        Some(f) => or_else(f.who, prev_person)
        None => prev_person
      },
    )
    let thread = or_else(
      row_field(t, "thread"),
      match first {
        Some(f) => or_else(f.thread, prev_thread)
        None => prev_thread
      },
    )
    out.push(
      TurnOut::{
        id: row_field(t, "id"),
        started_at: row_field(t, "started_at"),
        turn: row_field(t, "id"),
        person: person,
        thread: thread,
        profile: or_else(row_field(t, "profile"), profile),
      },
    )
  }
  if out.length() == 0 {
    out.push(
      TurnOut::{
        id: base_codec::json_str(""),
        started_at: base_codec::json_num(MIN_SAFE),
        turn: base_codec::json_null(),
        person: creator,
        thread: home,
        profile: profile,
      },
    )
  }

  let items : Array[base_codec::Json] = []
  for i in 0..<out.length() {
    let o = out[i]
    items.push(
      base_codec::json_obj([
        ("id", o.id),
        ("startedAt", o.started_at),
        (
          "of",
          base_codec::json_obj([
            ("turn", o.turn),
            ("person", o.person),
            ("thread", o.thread),
            ("profile", o.profile),
          ]),
        ),
      ]),
    )
  }
  Ok(base_codec::json_arr(items))
}
