  let n = self.name()?
  match n {
    "O0" => Ok(ui::Opacity::O0)
    "O5" => Ok(ui::Opacity::O5)
    "O10" => Ok(ui::Opacity::O10)
    "O15" => Ok(ui::Opacity::O15)
