// 1:1 pure-Pion port of `libs/ui/src/ui/style_css.mbt` (`@ui.css` / `@ui.css_read`)
// targeting `AFK-surf/invar` `ui::Style` / `ui::Patch` tokens with identical grammar,
// Clinger fast-path number parsing, and exact `Css::fail` cursor offsets.

import "ui"

pub fn css(text : String) -> ui::Style {
  match css_read(text) {
    Ok(st) => st
    Err(said) => panic(said)
  }
}

pub fn css_read(text : String) -> Result[ui::Style, String] {
  let r = Css::{ s: text, i: 0 }
  let st = CssStates::{
    narrow: None,
    dark: None,
    selected: None,
    hovered: None,
    focused: None,
    pressed: None,
    disabled: None,
  }
  let base = r.patch(Some(st))?
  Ok(ui::Style::{
    base,
    narrow: st.narrow,
    dark: st.dark,
    selected: st.selected,
    hovered: st.hovered,
    focused: st.focused,
    pressed: st.pressed,
    disabled: st.disabled,
  })
}

struct Css {
  s : String
  mut i : Int
}

struct CssStates {
  mut narrow : Option[ui::Patch]
  mut dark : Option[ui::Patch]
  mut selected : Option[ui::Patch]
  mut hovered : Option[ui::Patch]
  mut focused : Option[ui::Patch]
  mut pressed : Option[ui::Patch]
  mut disabled : Option[ui::Patch]
}

fn Css::fail[T](self : Css, what : String) -> Result[T, String] {
  Err("css: " + what + " at " + self.i.to_string() + " in \"" + self.s + "\"")
}

fn Css::peek(self : Css) -> Int {
  if self.i < self.s.length() {
    self.s.code_unit_at(self.i)
  } else {
    0
  }
}

fn Css::space(self : Css) -> Unit {
  while self.i < self.s.length() {
    let c = self.peek()
    if c == 32 || c == 10 || c == 9 {
      self.i = self.i + 1
    } else {
      break
    }
  }
}

fn is_name_byte(c : Int) -> Bool {
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95
}

fn Css::name(self : Css) -> Result[String, String] {
  self.space()
  let a = self.i
  while self.i < self.s.length() && is_name_byte(self.peek()) {
    self.i = self.i + 1
  }
  if self.i == a {
    return self.fail("a name wanted")
  }
  Ok(self.s.slice(a, self.i))
}

fn Css::expect(self : Css, c : Int, label : String) -> Result[Unit, String] {
  self.space()
  if self.peek() != c {
    return self.fail(label + " wanted")
  }
  self.i = self.i + 1
  Ok(())
}

fn css_pow10(e : Int) -> Result[Double, String] {
  match e {
    0 => Ok(1.0e0)
    1 => Ok(1.0e1)
    2 => Ok(1.0e2)
    3 => Ok(1.0e3)
    4 => Ok(1.0e4)
    5 => Ok(1.0e5)
    6 => Ok(1.0e6)
    7 => Ok(1.0e7)
    8 => Ok(1.0e8)
    9 => Ok(1.0e9)
    10 => Ok(1.0e10)
    11 => Ok(1.0e11)
    12 => Ok(1.0e12)
    13 => Ok(1.0e13)
    14 => Ok(1.0e14)
    15 => Ok(1.0e15)
    16 => Ok(1.0e16)
    17 => Ok(1.0e17)
    18 => Ok(1.0e18)
    19 => Ok(1.0e19)
    20 => Ok(1.0e20)
    21 => Ok(1.0e21)
    22 => Ok(1.0e22)
    _ => Err("css: 10^" + e.to_string() + " is not exact")
  }
}

fn Css::num(self : Css) -> Result[Double, String] {
  self.space()
  let neg = self.peek() == 45
  if neg {
    self.i = self.i + 1
  }
  let most = 9007199254740992L
  let mut m = 0L
  let mut e = 0
  let mut digits = false
  let mut point = false
  while self.i < self.s.length() {
    let c = self.peek()
    if c >= 48 && c <= 57 {
      m = m * 10L + (c - 48).to_int64()
      if m > most {
        return self.fail("a number with more digits than read exactly")
      }
      if point {
        e = e - 1
      }
      digits = true
    } else if c == 95 {
      ()
    } else if c == 46 && !point {
      point = true
    } else {
      break
    }
    self.i = self.i + 1
  }
  if !digits {
    return self.fail("a number wanted")
  }
  if self.peek() == 101 || self.peek() == 69 {
    self.i = self.i + 1
    let eneg = self.peek() == 45
    if eneg || self.peek() == 43 {
      self.i = self.i + 1
    }
    let mut x = 0
    let a = self.i
    while self.peek() >= 48 && self.peek() <= 57 && x < 1000 {
      x = x * 10 + (self.peek() - 48)
      self.i = self.i + 1
    }
    if self.i == a {
      return self.fail("an exponent wanted")
    }
    e = e + (if eneg { -x } else { x })
  }
  let v = if e >= 0 && e <= 22 {
    let p = css_pow10(e)?
    m.to_double() * p
  } else if e < 0 && e >= -22 {
    let p = css_pow10(-e)?
    m.to_double() / p
  } else {
    return self.fail("a number with a power of ten not read exactly")
  }
  if neg {
    Ok(-v)
  } else {
    Ok(v)
  }
}

fn Css::int64(self : Css) -> Result[Int64, String] {
  self.space()
  let neg = self.peek() == 45
  if neg {
    self.i = self.i + 1
  }
  let hex = self.peek() == 48 &&
  self.i + 1 < self.s.length() &&
  (self.s.code_unit_at(self.i + 1) == 120 || self.s.code_unit_at(self.i + 1) == 88)
  if hex {
    self.i = self.i + 2
  }
  let base = if hex { 16L } else { 10L }
  let mut m = 0L
  let mut digits = false
  while self.i < self.s.length() {
    let c = self.peek()
    if c == 95 {
      self.i = self.i + 1
      continue
    }
    let d = if c >= 48 && c <= 57 {
      c - 48
    } else if hex && c >= 97 && c <= 102 {
      c - 87
    } else if hex && c >= 65 && c <= 70 {
      c - 55
    } else {
      break
    }
    if m > (9223372036854775807L - d.to_int64()) / base {
      return self.fail("a number past an Int64")
    }
    m = m * base + d.to_int64()
    digits = true
    self.i = self.i + 1
  }
  if !digits {
    return self.fail("a number wanted")
  }
  if neg {
    Ok(-m)
  } else {
    Ok(m)
  }
}

fn Css::arg(self : Css) -> Result[Double, String] {
  self.expect(40, "(")?
  let v = self.num()?
  self.expect(41, ")")?
  Ok(v)
}

fn Css::arg_int64(self : Css) -> Result[Int64, String] {
  self.expect(40, "(")?
  let v = self.int64()?
  self.expect(41, ")")?
  Ok(v)
}

fn Css::bool(self : Css) -> Result[Bool, String] {
  let n = self.name()?
  match n {
    "true" => Ok(true)
    "false" => Ok(false)
    _ => self.fail("no Bool " + n)
  }
}

fn Css::len(self : Css) -> Result[ui::Len, String] {
  let n = self.name()?
