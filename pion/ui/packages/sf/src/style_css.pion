    "S72" => Ok(ui::Len::S72)
    "S80" => Ok(ui::Len::S80)
    "S96" => Ok(ui::Len::S96)
    _ => self.fail("no Len " + n)
  }
}

fn Css::space_token(self : Css) -> Result[ui::Space, String] {
  let n = self.name()?
  match n {
    "S0" => Ok(ui::Space::S0)
    "SPx" => Ok(ui::Space::SPx)
    "S0_5" => Ok(ui::Space::S0_5)
    "S1" => Ok(ui::Space::S1)
    "S1_25" => Ok(ui::Space::S1_25)
    "S1_5" => Ok(ui::Space::S1_5)
    "S2" => Ok(ui::Space::S2)
    "S2_5" => Ok(ui::Space::S2_5)
    "S3" => Ok(ui::Space::S3)
    "S3_5" => Ok(ui::Space::S3_5)
    "S4" => Ok(ui::Space::S4)
    "S4_5" => Ok(ui::Space::S4_5)
    "S5" => Ok(ui::Space::S5)
    "S6" => Ok(ui::Space::S6)
    "S7" => Ok(ui::Space::S7)
    "S8" => Ok(ui::Space::S8)
    "S9" => Ok(ui::Space::S9)
    "S10" => Ok(ui::Space::S10)
    "S11" => Ok(ui::Space::S11)
    "S12" => Ok(ui::Space::S12)
    "S14" => Ok(ui::Space::S14)
    "S16" => Ok(ui::Space::S16)
    "S20" => Ok(ui::Space::S20)
    "S24" => Ok(ui::Space::S24)
    "S28" => Ok(ui::Space::S28)
    "S32" => Ok(ui::Space::S32)
    "S36" => Ok(ui::Space::S36)
    "S40" => Ok(ui::Space::S40)
    "S44" => Ok(ui::Space::S44)
    "S48" => Ok(ui::Space::S48)
    "S52" => Ok(ui::Space::S52)
    "S56" => Ok(ui::Space::S56)
    "S60" => Ok(ui::Space::S60)
    "S64" => Ok(ui::Space::S64)
    "S72" => Ok(ui::Space::S72)
    "S80" => Ok(ui::Space::S80)
    "S96" => Ok(ui::Space::S96)
    "Exact" => Ok(ui::Space::Exact(self.arg()?))
    _ => self.fail("no Space " + n)
  }
}

fn Css::align(self : Css) -> Result[ui::Align, String] {
  let n = self.name()?
  match n {
    "AStart" => Ok(ui::Align::Start)
    "ACenter" => Ok(ui::Align::Center)
    "AEnd" => Ok(ui::Align::End)
    "AStretch" => Ok(ui::Align::Stretch)
    "AFirstLine" =>
    self.fail("unsupported Align AFirstLine (missing in invar ui::Align)")
    "ABaseline" => Ok(ui::Align::Baseline)
    _ => self.fail("no Align " + n)
  }
}

fn Css::justify(self : Css) -> Result[ui::Justify, String] {
  let n = self.name()?
  match n {
    "JStart" => Ok(ui::Justify::Start)
    "JCenter" => Ok(ui::Justify::Center)
    "JEnd" => Ok(ui::Justify::End)
    "JBetween" => Ok(ui::Justify::Between)
    _ => self.fail("no Justify " + n)
  }
}

fn Css::radius(self : Css) -> Result[ui::Radius, String] {
  let n = self.name()?
  match n {
    "Sharp" => Ok(ui::Radius::Sharp)
    "Sm" => Ok(ui::Radius::Sm)
    "Base" => Ok(ui::Radius::Base)
    "Md" => Ok(ui::Radius::Md)
    "Lg" => Ok(ui::Radius::Lg)
    "Xl" => Ok(ui::Radius::Xl)
    "Xl1_5" => Ok(ui::Radius::Xl1_5)
    "Xl2" => Ok(ui::Radius::Xl2)
    "Xl3" => Ok(ui::Radius::Xl3)
    "Xl4" => Ok(ui::Radius::Xl4)
    "Full" => Ok(ui::Radius::Full)
    "Inner" => Ok(ui::Radius::Inner)
    "InnerOr" => {
      self.expect(40, "(")?
      let own = self.radius()?
      self.expect(41, ")")?
      Ok(ui::Radius::InnerOr(own))
    }
    "Around" => Ok(ui::Radius::Around)
    "Exact" => Ok(ui::Radius::Exact(self.arg()?))
    _ => self.fail("no Radius " + n)
  }
}

fn Css::stroke(self : Css) -> Result[ui::Stroke, String] {
  let n = self.name()?
  match n {
    "B0" => Ok(ui::Stroke::B0)
    "B0_5" => Ok(ui::Stroke::B0_5)
    "B1" => Ok(ui::Stroke::B1)
    "B1_5" => Ok(ui::Stroke::B1_5)
    "B2" => Ok(ui::Stroke::B2)
    "B4" => Ok(ui::Stroke::B4)
    "B8" => Ok(ui::Stroke::B8)
    _ => self.fail("no Stroke " + n)
  }
}

fn Css::shadow(self : Css) -> Result[ui::Shadow, String] {
  let n = self.name()?
  match n {
    "NoShadow" => Ok(ui::Shadow::NoShadow)
    "Sm" => Ok(ui::Shadow::Sm)
    "Base" => Ok(ui::Shadow::Base)
    "Md" => Ok(ui::Shadow::Md)
    "Lg" => Ok(ui::Shadow::Lg)
    "Xl" => Ok(ui::Shadow::Xl)
    "Cast" => {
      self.expect(40, "(")?
      let blur = self.num()?
      self.expect(44, ",")?
      let y = self.num()?
      self.expect(44, ",")?
      let c = self.int64()?
      self.expect(41, ")")?
      Ok(ui::Shadow::Cast(blur, y, c))
    }
    _ => self.fail("no Shadow " + n)
  }
}

