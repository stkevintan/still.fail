    "Fixed" => Ok(ui::Len::Fixed(self.arg()?))
    "Pct" => Ok(ui::Len::Pct(self.arg()?))
    "Within" => Ok(ui::Len::Within(self.arg()?))
    "S0" => Ok(ui::Len::S0)
    "SPx" => Ok(ui::Len::SPx)
    "S0_5" => Ok(ui::Len::S0_5)
    "S1" => Ok(ui::Len::S1)
    "S1_25" => Ok(ui::Len::S1_25)
    "S1_5" => Ok(ui::Len::S1_5)
    "S2" => Ok(ui::Len::S2)
    "S2_5" => Ok(ui::Len::S2_5)
    "S3" => Ok(ui::Len::S3)
    "S3_5" => Ok(ui::Len::S3_5)
    "S4" => Ok(ui::Len::S4)
    "S4_5" => Ok(ui::Len::S4_5)
    "S5" => Ok(ui::Len::S5)
    "S6" => Ok(ui::Len::S6)
    "S7" => Ok(ui::Len::S7)
    "S8" => Ok(ui::Len::S8)
    "S9" => Ok(ui::Len::S9)
    "S10" => Ok(ui::Len::S10)
    "S11" => Ok(ui::Len::S11)
    "S12" => Ok(ui::Len::S12)
    "S14" => Ok(ui::Len::S14)
    "S16" => Ok(ui::Len::S16)
    "S20" => Ok(ui::Len::S20)
    "S24" => Ok(ui::Len::S24)
    "S28" => Ok(ui::Len::S28)
    "S32" => Ok(ui::Len::S32)
    "S36" => Ok(ui::Len::S36)
    "S40" => Ok(ui::Len::S40)
    "S44" => Ok(ui::Len::S44)
    "S48" => Ok(ui::Len::S48)
    "S52" => Ok(ui::Len::S52)
    "S56" => Ok(ui::Len::S56)
