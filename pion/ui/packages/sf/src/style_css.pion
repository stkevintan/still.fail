    "O30" => Ok(ui::Opacity::O30)
    "O35" => Ok(ui::Opacity::O35)
    "O40" => Ok(ui::Opacity::O40)
    "O45" => Ok(ui::Opacity::O45)
    "O50" => Ok(ui::Opacity::O50)
    "O55" => Ok(ui::Opacity::O55)
    "O60" => Ok(ui::Opacity::O60)
    "O65" => Ok(ui::Opacity::O65)
    "O70" => Ok(ui::Opacity::O70)
    "O75" => Ok(ui::Opacity::O75)
    "O80" => Ok(ui::Opacity::O80)
    "O85" => Ok(ui::Opacity::O85)
    "O90" => Ok(ui::Opacity::O90)
    "O95" => Ok(ui::Opacity::O95)
    "O100" => Ok(ui::Opacity::O100)
    "Exact" => Ok(ui::Opacity::Exact(self.arg()?))
    _ => self.fail("no Opacity " + n)
  }
}

fn Css::color(self : Css) -> Result[ui::Color, String] {
  let n = self.name()?
  match n {
    "Clear" => Ok(ui::Color::Clear)
    "Bg" => Ok(ui::Color::Bg)
    "Surface" => Ok(ui::Color::Surface)
    "Raised" => Ok(ui::Color::Raised)
    "Card" => Ok(ui::Color::Card)
    "Fg" => Ok(ui::Color::Fg)
    "Muted" => Ok(ui::Color::Muted)
    "Subtle" => Ok(ui::Color::Subtle)
    "Faint" => Ok(ui::Color::Faint)
    "Line" => Ok(ui::Color::Line)
    "Border" => Ok(ui::Color::Border)
    "Accent" => Ok(ui::Color::Accent)
    "AccentText" => Ok(ui::Color::AccentText)
    "AccentBg" => Ok(ui::Color::AccentBg)
    "OnAccent" => Ok(ui::Color::OnAccent)
    "Primary" => Ok(ui::Color::Primary)
    "OnPrimary" => Ok(ui::Color::OnPrimary)
    "Positive" => Ok(ui::Color::Positive)
    "Danger" => Ok(ui::Color::Danger)
    "DangerBg" => Ok(ui::Color::DangerBg)
    "OnDanger" => Ok(ui::Color::OnDanger)
    "Neutral" => Ok(ui::Color::Neutral)
    "Hover" => Ok(ui::Color::Hover)
    "Selected" => Ok(ui::Color::Selected)
    "Focus" => Ok(ui::Color::Focus)
    "Scrim" => Ok(ui::Color::Scrim)
    "Link" => Ok(ui::Color::Link)
    "ShadowC" => Ok(ui::Color::ShadowC)
    "Warn" => Ok(ui::Color::Warn)
    "WarnInk" => Ok(ui::Color::WarnInk)
    "Tint" => Ok(ui::Color::Tint)
    "TintStrong" => Ok(ui::Color::TintStrong)
    "Floating" => Ok(ui::Color::Floating)
    "Veil" => Ok(ui::Color::Veil)
    "VeilDeep" => Ok(ui::Color::VeilDeep)
    "OnVeil" => Ok(ui::Color::OnVeil)
    "Theater" => Ok(ui::Color::Theater)
    "Lifted" => Ok(ui::Color::Lifted)
    "Wash" => Ok(ui::Color::Wash)
    "Sidebar" => Ok(ui::Color::Sidebar)
    "ListGround" => Ok(ui::Color::ListGround)
    "FieldHover" => Ok(ui::Color::FieldHover)
    "A" => {
      self.expect(40, "(")?
      let c = self.color()?
      self.expect(44, ",")?
      let o = self.opacity()?
      self.expect(41, ")")?
      Ok(ui::Color::A(c, o))
    }
    "Over" => {
      self.expect(40, "(")?
      let a = self.color()?
      self.expect(44, ",")?
      let b = self.color()?
      self.expect(41, ")")?
      Ok(ui::Color::Over(a, b))
    }
    "Exact" => Ok(ui::Color::Exact(self.arg_int64()?))
    "Data" => Ok(ui::Color::Data(self.arg_int64()?))
    _ => self.fail("no Color " + n)
  }
}

fn Css::patch(self : Css, states : Option[CssStates]) -> Result[ui::Patch, String] {
  let mut row : Option[Bool] = None
  let mut w : Option[ui::Len] = None
  let mut h : Option[ui::Len] = None
  let mut min_w : Option[ui::Len] = None
  let mut max_w : Option[ui::Len] = None
  let mut min_h : Option[ui::Len] = None
  let mut max_h : Option[ui::Len] = None
  let mut p : Option[ui::Space] = None
  let mut px : Option[ui::Space] = None
  let mut py : Option[ui::Space] = None
  let mut pl : Option[ui::Space] = None
  let mut pr : Option[ui::Space] = None
  let mut pt : Option[ui::Space] = None
  let mut pb : Option[ui::Space] = None
  let mut m : Option[ui::Space] = None
  let mut mx : Option[ui::Space] = None
  let mut my : Option[ui::Space] = None
  let mut ml : Option[ui::Space] = None
  let mut mr : Option[ui::Space] = None
  let mut mt : Option[ui::Space] = None
  let mut mb : Option[ui::Space] = None
  let mut gap : Option[ui::Space] = None
  let mut align : Option[ui::Align] = None
  let mut justify : Option[ui::Justify] = None
  let mut bg : Option[ui::Color] = None
  let mut radius : Option[ui::Radius] = None
  let mut border : Option[ui::Stroke] = None
  let mut border_color : Option[ui::Color] = None
  let mut dashed : Option[Bool] = None
  let mut shadow : Option[ui::Shadow] = None
  let mut clip : Option[Bool] = None
  let mut opacity : Option[ui::Opacity] = None

  while true {
    self.space()
    if self.i >= self.s.length() {
      if states is None {
        return self.fail("a block not closed")
      }
      break
    }
    if self.peek() == 125 {
      if states is Some(_) {
        return self.fail("a } closing no block")
      }
      self.i = self.i + 1
      break
    }
    let key = self.name()?
    let pk = self.peek()
    if pk == 123 {
      self.i = self.i + 1
      let st = match states {
        Some(s) => s
        None => return self.fail("a block in a block")
      }
      let b = Some(self.patch(None)?)
      match key {
        "narrow" => st.narrow = b
        "dark" => st.dark = b
        "selected" => st.selected = b
        "hovered" => st.hovered = b
        "focused" => st.focused = b
        "pressed" => st.pressed = b
        "disabled" => st.disabled = b
        _ => return self.fail("no state " + key)
      }
    } else if pk == 61 {
      self.i = self.i + 1
      match key {
        "row" => row = Some(self.bool()?)
        "w" => w = Some(self.len()?)
        "h" => h = Some(self.len()?)
        "min_w" => min_w = Some(self.len()?)
        "max_w" => max_w = Some(self.len()?)
        "min_h" => min_h = Some(self.len()?)
        "max_h" => max_h = Some(self.len()?)
        "p" => p = Some(self.space_token()?)
        "px" => px = Some(self.space_token()?)
        "py" => py = Some(self.space_token()?)
        "pl" => pl = Some(self.space_token()?)
        "pr" => pr = Some(self.space_token()?)
        "pt" => pt = Some(self.space_token()?)
        "pb" => pb = Some(self.space_token()?)
        "m" => m = Some(self.space_token()?)
        "mx" => mx = Some(self.space_token()?)
        "my" => my = Some(self.space_token()?)
        "ml" => ml = Some(self.space_token()?)
        "mr" => mr = Some(self.space_token()?)
        "mt" => mt = Some(self.space_token()?)
        "mb" => mb = Some(self.space_token()?)
        "gap" => gap = Some(self.space_token()?)
        "align" => align = Some(self.align()?)
        "justify" => justify = Some(self.justify()?)
        "bg" => bg = Some(self.color()?)
        "radius" => radius = Some(self.radius()?)
        "border" => border = Some(self.stroke()?)
        "border_color" => border_color = Some(self.color()?)
        "dashed" => dashed = Some(self.bool()?)
        "shadow" => shadow = Some(self.shadow()?)
        "clip" => clip = Some(self.bool()?)
        "opacity" => opacity = Some(self.opacity()?)
        _ => return self.fail("no property " + key)
      }
    } else {
      match key {
        "row" => row = Some(true)
        "clip" => clip = Some(true)
        "dashed" => dashed = Some(true)
        _ => return self.fail(key + " with no value")
      }
    }
    let after = self.peek()
    if after == 32 || after == 10 || after == 9 || after == 125 || self.i >= self.s.length() {
      ()
    } else {
      return self.fail("an item not ended by a space")
    }
  }

  Ok(ui::Patch::{
    row,
    w,
    h,
    min_w,
    max_w,
    min_h,
    max_h,
    p,
    px,
    py,
    pl,
    pr,
    pt,
    pb,
    m,
    mx,
    my,
    ml,
    mr,
    mt,
    mb,
    gap,
    align,
    justify,
    bg,
    radius,
    border,
    border_color,
    dashed,
    shadow,
    clip,
    opacity,
  })
}
