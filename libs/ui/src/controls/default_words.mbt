///|
/// Built-in bilingual lookup for `key` in the current `language()` ("zh" or "en"), substituting `{name}` pairs from
/// `args` and falling back to `key` when `key` is not in the built-in table.
pub fn default_words(key : String, args : Array[(String, String)]) -> String {
  let raw = if language() == "en" {
    if args.iter().any(fn(a) { a.0 == "n" && a.1 == "1" }) && default_words_en.get(key + ".one") is Some(one) {
      one
    } else {
      match default_words_en.get(key) {
        Some(s) => s
        None => default_words_zh.get(key).unwrap_or(key)
      }
    }
  } else {
    default_words_zh.get(key).unwrap_or(key)
  }
  let mut s = branded(raw)
  for a in args {
    s = s.replace_all(old="{" + a.0 + "}", new=a.1)
  }
  s
}
