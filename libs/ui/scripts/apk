#!/bin/sh
# An Android app's APK without Gradle (tools/apk, in MoonBit; its main.mbt says how):
#   apk lock APP.json
#   apk build APP.json --variant V --version-code N --version-name S --out APK [--abi A]
#       [--keystore K] [--key-alias A] [--ks-pass SPEC] [--key-pass SPEC] [--v3-signing] [--verify-cert SHA256] [--dex-only]
#   apk repack IN.apk --out OUT.apk [--app-id ID] [--label NAME] [--version-code N] [--version-name S]
#       [--env K=V;...] [--edge-to-edge true|false] [--ground C] [--url-scheme S] [--permission P] [--manifest PATH]
#       [--keystore K] [--key-alias A] [--ks-pass SPEC] [--key-pass SPEC] [--v3-signing] [--verify-cert SHA256]
#   apk fetch PATH SHA256
# Built here only when there is none built from these very sources (by content).
D=$(cd "$(dirname "$0")" && pwd)
T=$D/../tools
TOOLS_SCRIPTS=$D; . "$D/tooltarget.sh"
B=$T/_build/$TT/release/build/apk/apk.$TX
src=$(cd "$T" && find apk sys re rjson moon.mod moon.work -type f | LC_ALL=C sort | xargs cat | cksum)
# (`key`: what it is built from, said: the key CI keeps the tool by, .github/actions/mbui-moonbit)
[ "${1:-}" != key ] || { echo "$src" | tr ' ' -; exit 0; }
# (MBUI_TOOLS_OUT: built there, mbui left as it is, when there is none built here from these sources: scripts/mbc)
TD=; if [ -n "${MBUI_TOOLS_OUT:-}" ] && [ "$(cat "$B.src" 2>/dev/null)" != "$src" ]; then
  TD=$(mkdir -p "$MBUI_TOOLS_OUT" && cd "$MBUI_TOOLS_OUT" && pwd) && B=$TD/$TT/release/build/apk/apk.$TX
fi
if [ ! -f "$B" ] || [ "$(cat "$B.src" 2>/dev/null)" != "$src" ]; then
  (cd "$T" && env -u MOON_CC moon build ${TD:+--target-dir "$TD"} --target $TT --release apk >&2) || { echo "apk: tools/apk did not build" >&2; exit 1; }
  echo "$src" > "$B.src"
fi
[ "${1:-}" != path ] || { echo "$B"; exit 0; }
APK_HOME=$D tool_exec "$B" "$@"
